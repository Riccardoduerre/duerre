---
import Layout from './Layout.astro';
import type { Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  image?: string;
}

const { title, description, lang, image } = Astro.props;
---

<Layout title={title} description={description} lang={lang} image={image} type="article">
  <div class="mx-auto max-w-6xl px-6 sm:px-10 py-16 md:py-28">
    <slot />
  </div>
</Layout>
