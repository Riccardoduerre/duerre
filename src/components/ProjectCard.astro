---
import ServiceProjectCard from './ServiceProjectCard.astro';
import type { PortfolioItem } from '../lib/content';
import { splitId } from '../lib/content';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  project: PortfolioItem;
  index?: number;
  lang?: Locale;
}

const { project, index = 0, lang: propLang } = Astro.props;
const parsed = splitId(project.id);
const lang: Locale = propLang || (parsed.lang === 'en' ? 'en' : 'it');
const { slug } = parsed;
const t = useTranslations(lang);
---

<ServiceProjectCard
  title={project.data.title}
  description={project.data.description}
  href={localePath(lang, `/portfolio/${slug}/`)}
  category={t(`category_${project.data.category}`)}
  coverImage={project.data.coverImage}
  coverAlt={project.data.coverAlt}
  index={index}
  client={project.data.client}
  year={project.data.year}
  aspectRatio="4/5"
  aspectRatioLabel={project.data.aspectRatio}
  youtubeId={project.data.youtubeId}
  tags={project.data.services || project.data.tags}
  transitionSlug={slug}
  ctaLabel={t('view_project')}
/>
