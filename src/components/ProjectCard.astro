---
import { Picture } from 'astro:assets';
import type { Project } from '../lib/content';
import { splitId } from '../lib/content';
import { localePath, useTranslations } from '../i18n';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { slug, lang } = splitId(project.id);
const t = useTranslations(lang);
---

<article class="group">
  <a href={localePath(lang, `/projects/${slug}/`)} class="block">
    <div class="relative overflow-hidden rounded-2xl border border-line bg-surface aspect-[78/70] media-zoom">
      <Picture
        formats={['avif', 'webp']}
        src={project.data.cover}
        alt={project.data.coverAlt}
        class="object-cover w-full h-full"
        widths={[400, 800]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        height={700}
      />
      <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-end p-5">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#141414] shadow-xl transform translate-y-3 group-hover:translate-y-0 transition-transform duration-300">
          ↗
        </span>
      </div>
    </div>
    <div class="mt-5">
      <span class="block text-xs font-bold uppercase tracking-[0.14em] text-muted mb-1.5">
        {t(`category_${project.data.category}`)} · {project.data.year}
      </span>
      <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink group-hover:opacity-75 transition-opacity">
        {project.data.title}
      </h3>
    </div>
  </a>
</article>
