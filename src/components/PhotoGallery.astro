---
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  images: { image: ImageMetadata; alt: string; caption?: string }[];
}

const { images } = Astro.props;
const lightboxSources = await Promise.all(
  images.map((img) => getImage({ src: img.image, width: Math.min(img.image.width, 2400), format: 'webp' })),
);
---

<div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8">
  {images.map((img, index) => {
    const spanClass =
      images.length === 2
        ? 'md:col-span-6'
        : index % 3 === 0
          ? 'md:col-span-12'
          : 'md:col-span-6';
    const aspectClass = index % 3 === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]';

    return (
      <figure
        class={`${spanClass} group relative cursor-zoom-in overflow-hidden bg-surface`}
        data-gallery-item
        data-img-src={lightboxSources[index].src}
        data-alt={img.alt}
        data-caption={img.caption || ''}
        data-index={index}
        data-reveal
        tabindex="0"
        role="button"
        aria-label={`View photo: ${img.alt}`}
      >
        <div class={`overflow-hidden ${aspectClass} media-zoom`}>
          <Picture
            formats={['avif', 'webp']}
            src={img.image}
            alt={img.alt}
            class="w-full h-full object-cover"
            widths={[600, 1200, 1800, 2400]}
            sizes={index % 3 === 0 ? '100vw' : '(max-width: 768px) 100vw, 50vw'}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.22em] text-muted">
          <span>FIG. {String(index + 1).padStart(2, '0')}</span>
          {img.caption && <span class="text-ink/80 normal-case tracking-normal font-sans text-xs">{img.caption}</span>}
        </figcaption>
      </figure>
    );
  })}
</div>

<!-- Native High-Performance Image Lightbox Modal -->
<dialog
  id="photo-lightbox"
  class="fixed inset-0 m-auto max-w-[96vw] max-h-[96vh] bg-transparent p-0 border-0 outline-hidden select-none z-50"
>
  <div class="relative flex flex-col items-center justify-center p-4">
    <div class="w-full max-w-[90vw] flex items-center justify-between mb-4 text-white">
      <span id="lightbox-counter" class="font-mono text-[11px] tracking-[0.24em] text-[#CCA870] uppercase"></span>
      <button
        id="lightbox-close"
        type="button"
        class="px-4 py-1.5 border border-white/25 font-mono text-[10px] uppercase tracking-[0.24em] text-white hover:bg-white hover:text-black transition cursor-pointer"
        aria-label="Close lightbox"
      >
        Close [ESC]
      </button>
    </div>

    <div class="relative overflow-hidden bg-black/60 border border-white/10 shadow-2xl flex flex-col items-center group">
      <img
        id="lightbox-img"
        src=""
        alt=""
        loading="lazy"
        decoding="async"
        class="max-h-[80vh] max-w-[90vw] object-contain"
      />

      <button
        id="lightbox-prev"
        type="button"
        class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/65 border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-black transition cursor-pointer"
        aria-label="Previous image"
      >
        ←
      </button>
      <button
        id="lightbox-next"
        type="button"
        class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/65 border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-black transition cursor-pointer"
        aria-label="Next image"
      >
        →
      </button>

      <div id="lightbox-caption" class="w-full py-3 px-6 text-center font-mono text-xs text-white/80 bg-black/85"></div>
    </div>
  </div>
</dialog>

<script>
  function initLightbox() {
    const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const items = Array.from(document.querySelectorAll('[data-gallery-item]')) as HTMLElement[];
    let currentIndex = 0;

    if (!dialog || !lightboxImg || items.length === 0) return;

    function showIndex(idx: number) {
      if (idx < 0) idx = items.length - 1;
      if (idx >= items.length) idx = 0;
      currentIndex = idx;
      const item = items[currentIndex];
      if (!item || !lightboxImg) return;
      lightboxImg.src = item.dataset.imgSrc || '';
      lightboxImg.alt = item.dataset.alt || '';

      if (lightboxCounter) {
        lightboxCounter.textContent = `FRAME ${String(currentIndex + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
      }

      const caption = item.dataset.caption;
      if (lightboxCaption) {
        if (caption) {
          lightboxCaption.textContent = caption;
          lightboxCaption.classList.remove('hidden');
        } else {
          lightboxCaption.classList.add('hidden');
        }
      }
    }

    items.forEach((item, index) => {
      const openModal = () => {
        showIndex(index);
        dialog.showModal();
      };

      item.onclick = openModal;
      item.onkeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal();
        }
      };
    });

    if (closeBtn) closeBtn.onclick = () => dialog.close();
    if (prevBtn)
      prevBtn.onclick = (e) => {
        e.stopPropagation();
        showIndex(currentIndex - 1);
      };
    if (nextBtn)
      nextBtn.onclick = (e) => {
        e.stopPropagation();
        showIndex(currentIndex + 1);
      };

    dialog.onclick = (e) => {
      if (e.target === dialog) dialog.close();
    };

    window.onkeydown = (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight') {
        showIndex(currentIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        showIndex(currentIndex - 1);
      }
    };
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
