---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  images: { image: ImageMetadata; alt: string; caption?: string }[];
}

const { images } = Astro.props;
---

<div class="columns-1 sm:columns-2 lg:columns-3 gap-6">
  {images.map((img) => (
    <figure class="mb-6 last:mb-0 break-inside-avoid group relative overflow-hidden rounded-xl bg-surface border border-line/60 transition duration-500 hover:border-accent/60 hover:shadow-2xl">
      <div class="overflow-hidden">
        <Picture formats={['avif', 'webp']} 
          src={img.image} 
          alt={img.alt} 
          class="w-full object-cover transition duration-700 ease-out group-hover:scale-105"
          widths={[400, 800, 1200, 1800]} 
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        />
      </div>
      {img.caption && (
        <figcaption class="p-3 text-xs text-muted border-t border-line/40 bg-surface/80">
          {img.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
