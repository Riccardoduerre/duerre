---
import { type Locale, useTranslations, localePath } from '../i18n';
import { SITE } from '../config/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="section-carbon border-t border-white/10 pt-20 pb-12">
  <div class="mx-auto max-w-7xl px-6 grid gap-12 md:grid-cols-2 lg:grid-cols-12">
    <!-- Column 1: Brand, Tagline & Socials -->
    <div class="lg:col-span-4">
      <a href={localePath(lang, '/')} class="inline-flex items-center gap-3 text-white mb-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white text-[#141414] text-sm font-extrabold tracking-tighter">
          DR
        </span>
        <span class="text-xl font-extrabold uppercase tracking-tight">Duerre</span>
      </a>
      <p class="text-sm text-[#A8A8A8] max-w-sm mb-8 leading-relaxed">
        {t('footer_tagline')}<br />
        {t('studio_blurb')}
      </p>
      <div class="flex items-center gap-3">
        {SITE.social.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-white hover:text-[#141414] transition-colors"
          >
            <span>{item.name}</span>
            <span>↗</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Column 2: Services & Navigation -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-white mb-5">
        {t('nav_services')}
      </h3>
      <ul class="space-y-3 text-sm text-[#A8A8A8]">
        <li>
          <a href={`${localePath(lang, '/services/')}#commercial-photography`} class="hover:text-white transition-colors">
            Commercial Photography
          </a>
        </li>
        <li>
          <a href={`${localePath(lang, '/services/')}#cinema-video-production`} class="hover:text-white transition-colors">
            Cinema & Video Production
          </a>
        </li>
        <li>
          <a href={`${localePath(lang, '/services/')}#3d-cgi-rendering`} class="hover:text-white transition-colors">
            3D CGI & Product Rendering
          </a>
        </li>
        <li>
          <a href={`${localePath(lang, '/services/')}#digital-marketing`} class="hover:text-white transition-colors">
            Digital Marketing
          </a>
        </li>
      </ul>

      <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-wider text-[#A8A8A8]">
        <a href={localePath(lang, '/about/')} class="hover:text-white transition-colors">{t('nav_about')}</a>
        <a href={localePath(lang, '/projects/')} class="hover:text-white transition-colors">{t('nav_projects')}</a>
        <a href={localePath(lang, '/blog/')} class="hover:text-white transition-colors">{t('nav_blog')}</a>
        <a href={localePath(lang, '/contact/')} class="hover:text-white transition-colors">{t('nav_contact')}</a>
      </div>
    </div>

    <!-- Column 3: Contatti / Studio Info -->
    <div class="lg:col-span-2">
      <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-white mb-5">
        {t('nav_contact')}
      </h3>
      <ul class="space-y-4 text-sm text-[#A8A8A8]">
        <li>
          <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-1">Studio</span>
          <span class="text-white font-medium">{SITE.author}</span>
        </li>
        <li>
          <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-1">Location</span>
          <span>{SITE.location}</span>
        </li>
        <li>
          <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-1">Email</span>
          <a href={`mailto:${SITE.email}`} class="text-white hover:underline break-all">
            {SITE.email}
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 4: Newsletter -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-white mb-3">
        {t('newsletter_title')}
      </h3>
      <p class="text-sm text-[#A8A8A8] mb-5 leading-relaxed">
        {t('newsletter_desc')}
      </p>
      <form
        action={`mailto:${SITE.email}`}
        method="GET"
        class="flex flex-col gap-3"
      >
        <input type="hidden" name="subject" value="Newsletter Subscription — Duerre" />
        <input
          type="email"
          name="body"
          required
          placeholder={t('newsletter_placeholder')}
          class="w-full rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 focus:border-white focus:outline-hidden"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-xs font-bold uppercase tracking-[0.14em] text-[#141414] transition hover:bg-[#D9D9D9]"
        >
          <span>{t('newsletter_btn')}</span>
          <span>↗</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Copyright Bottom Bar -->
  <div class="mx-auto max-w-7xl px-6 mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center text-xs text-[#A8A8A8]">
    <p>&copy; {year} Duerre · {SITE.author}. All rights reserved.</p>
    <p class="mt-3 sm:mt-0">{t('footer_stack')}</p>
  </div>
</footer>
