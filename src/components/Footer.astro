---
import { type Locale, useTranslations, localePath } from '../i18n';
import { SITE } from '../config/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface/50 py-16 md:py-20 mt-28">
  <div class="mx-auto max-w-7xl px-6 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-line text-[11px] font-mono uppercase tracking-wider text-muted mb-6">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Italy · Available for select commissions</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-ink">{t('contact_title')}</h2>
      <p class="text-sm text-muted max-w-md mb-8 leading-relaxed">
        {lang === 'it' 
          ? 'Direzione visiva, fotografia commerciale e rendering 3D CGI per brand e agenzie.'
          : 'Visual direction, commercial photography, and 3D CGI production for premium brands.'}
      </p>
      <a href={localePath(lang, '/contact/')} class="btn-primary inline-flex">{t('nav_cta')}</a>
    </div>

    <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 text-xs">
      <div>
        <h3 class="font-semibold mb-4 text-accent uppercase tracking-[0.16em]">Index</h3>
        <ul class="space-y-3 flex flex-col text-muted font-medium">
          <li><a href={localePath(lang, '/projects/')} class="hover:text-ink transition-colors">{t('nav_projects')}</a></li>
          <li><a href={localePath(lang, '/about/')} class="hover:text-ink transition-colors">{t('nav_about')}</a></li>
          <li><a href={localePath(lang, '/blog/')} class="hover:text-ink transition-colors">{t('nav_blog')}</a></li>
          <li><a href={localePath(lang, '/contact/')} class="hover:text-ink transition-colors">{t('nav_contact')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-4 text-accent uppercase tracking-[0.16em]">Disciplines</h3>
        <ul class="space-y-3 flex flex-col text-muted font-medium">
          <li>Commercial Photography</li>
          <li>Cinema & Motion</li>
          <li>3D CGI & VFX</li>
          <li>ACES Color Science</li>
        </ul>
      </div>

      <div class="col-span-2 sm:col-span-1">
        <h3 class="font-semibold mb-4 text-accent uppercase tracking-[0.16em]">{t('social_label')}</h3>
        <ul class="space-y-3 flex flex-col text-muted font-medium">
          {SITE.social.map((item) => (
            <li>
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-ink transition-colors inline-flex items-center gap-1"
              >
                {item.name} ↗
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-ink transition-colors">
              {SITE.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 mt-16 pt-8 border-t border-line flex flex-col sm:flex-row justify-between items-center text-[11px] font-mono text-muted uppercase tracking-wider">
    <p>&copy; {year} Duerremedia · Riccardo Riva</p>
    <p class="mt-4 sm:mt-0">{t('footer_stack')}</p>
  </div>
</footer>
