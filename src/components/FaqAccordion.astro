---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow: string;
  title: string;
  items: FaqItem[];
}

const { eyebrow, title, items } = Astro.props;
---

<section class="py-24 md:py-32 px-6 max-w-7xl mx-auto">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <div class="lg:col-span-5">
      <span class="pill-subtext mb-5">{eyebrow}</span>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.12] text-ink">
        {title}
      </h2>
    </div>

    <div class="lg:col-span-7 divide-y divide-line border-y border-line">
      {items.map((item, idx) => (
        <details class="group py-6 transition-all" open={idx === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg sm:text-xl font-bold text-ink hover:opacity-80">
            <span>{item.question}</span>
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line text-ink transition-transform duration-300 group-open:rotate-180 group-open:bg-ink group-open:text-bg group-open:border-ink">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pr-12 text-sm sm:text-base leading-relaxed text-muted">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

