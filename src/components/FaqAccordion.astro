---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow: string;
  title: string;
  items: FaqItem[];
}

const { eyebrow, title, items } = Astro.props;
---

<section class="py-28 md:py-40 px-6 sm:px-10 max-w-[1440px] mx-auto" data-reveal>
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-start">
    <div class="lg:col-span-5">
      <span class="pill-subtext mb-6">{eyebrow}</span>
      <h2 class="display-section text-ink">
        {title}
      </h2>
    </div>

    <div class="lg:col-span-7 divide-y divide-line/60 border-y border-line/60">
      {items.map((item, idx) => (
        <details class="group py-8 transition-all" open={idx === 0}>
          <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 text-left text-lg sm:text-2xl font-light tracking-tight text-ink hover:text-accent transition-colors">
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-[10px] tracking-[0.22em] text-accent">
                0{idx + 1}
              </span>
              <span>{item.question}</span>
            </div>
            <span class="font-mono text-sm text-muted transition-transform duration-500 group-open:rotate-45 group-open:text-accent">
              +
            </span>
          </summary>
          <div class="mt-5 pl-8 pr-8 text-sm sm:text-base font-light leading-relaxed text-muted">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
