---
import { useTranslations, localePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section-carbon py-16 md:py-24 px-6 border-t border-white/10">
  <div class="mx-auto max-w-7xl">
    <div class="relative overflow-hidden rounded-3xl border border-white/15 bg-[#141414] p-8 sm:p-14 lg:p-20">
      <!-- Subtle architectural grid lines -->
      <div class="pointer-events-none absolute inset-0 bg-grid-lines-dark opacity-60"></div>

      <div class="relative z-10 grid lg:grid-cols-12 gap-10 items-center">
        <!-- Left Brand Monogram Emblem -->
        <div class="lg:col-span-2 flex items-center justify-start">
          <div class="flex h-20 w-20 sm:h-24 sm:w-24 items-center justify-center rounded-2xl border border-white/20 bg-white/5 text-white">
            <span class="text-3xl sm:text-4xl font-extrabold tracking-tighter">DR</span>
          </div>
        </div>

        <!-- Center Dual-Weight Italic Heading + Description -->
        <div class="lg:col-span-7">
          <div class="text-3xl sm:text-5xl lg:text-[52px] leading-[1.08] tracking-tight text-[#D9D9D9] uppercase">
            <div>
              <span class="font-extrabold text-white">{t('cta_dual_1_bold')}</span>{' '}
              <span class="font-light italic text-[#A8A8A8]">{t('cta_dual_1_italic')}</span>
            </div>
            <div>
              <span class="font-light italic text-[#A8A8A8]">{t('cta_dual_2_italic')}</span>{' '}
              <span class="font-extrabold text-white">{t('cta_dual_2_bold')}</span>
            </div>
          </div>
          <p class="mt-6 max-w-xl text-sm sm:text-base leading-relaxed text-[#A8A8A8]">
            {t('cta_dual_desc')}
          </p>
        </div>

        <!-- Right CTA Action -->
        <div class="lg:col-span-3 flex lg:justify-end">
          <a
            href={localePath(lang, '/contact/')}
            class="inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 text-xs sm:text-sm font-bold uppercase tracking-[0.14em] text-[#141414] transition duration-300 hover:bg-[#D9D9D9]"
          >
            <span>{t('nav_cta')}</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7V16" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

