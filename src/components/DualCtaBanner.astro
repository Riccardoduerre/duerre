---
import { useTranslations, localePath, type Locale } from '../i18n';
import { SITE } from '../config/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section-carbon py-28 md:py-40 px-6 sm:px-10 border-t border-white/10">
  <div class="mx-auto max-w-[1440px]" data-reveal>
    <div class="grid lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8">
        <span class="pill-subtext-dark mb-8">
          {t('contact_breadcrumb_sub')} · {SITE.location}
        </span>
        <h2 class="display-editorial text-white uppercase">
          <span class="font-semibold">{t('cta_dual_1_bold')}</span>{' '}
          <span class="italic font-light text-white/60">{t('cta_dual_1_italic')}</span>
          <br />
          <span class="italic font-light text-[#CCA870]">{t('cta_dual_2_italic')}</span>{' '}
          <span class="font-semibold">{t('cta_dual_2_bold')}</span>
        </h2>
        <p class="mt-8 max-w-xl text-base sm:text-lg font-light leading-relaxed text-white/65">
          {t('cta_dual_desc')}
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col lg:items-end justify-between gap-6">
        <a
          href={localePath(lang, '/contact/')}
          class="inline-flex items-center gap-4 rounded-full bg-white px-9 py-5 font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-[#070707] transition-all duration-500 hover:bg-[#CCA870] hover:text-black"
        >
          <span>{t('nav_cta')}</span>
          <span>↗</span>
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="font-mono text-[11px] uppercase tracking-[0.22em] text-white/55 hover:text-white transition-colors"
        >
          {SITE.email}
        </a>
      </div>
    </div>
  </div>
</section>
