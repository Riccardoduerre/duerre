---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';
import { SITE } from '../../config/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const nextSteps =
  lang === 'it'
    ? [
        {
          num: '01',
          title: 'Analisi del Brief',
          desc: 'Esaminiamo gli obiettivi visivi, le discipline selezionate e le tempistiche indicate nella tua richiesta.',
        },
        {
          num: '02',
          title: 'Riscontro entro 24–48 Ore',
          desc: 'Riceverai una risposta personale via email con prime valutazioni tecniche e disponibilità di produzione.',
        },
        {
          num: '03',
          title: 'Call di Direzione & Trattamento',
          desc: 'Definiamo insieme direzione creativa, deliverables e piano di produzione su misura per il tuo brand.',
        },
      ]
    : [
        {
          num: '01',
          title: 'Brief Review',
          desc: 'We review your visual objectives, selected disciplines, and production timeline.',
        },
        {
          num: '02',
          title: 'Direct Reply in 24–48h',
          desc: 'You will receive a personal email response with initial technical notes and studio availability.',
        },
        {
          num: '03',
          title: 'Direction Call & Treatment',
          desc: 'We align on creative treatment, deliverables, and a tailored production schedule.',
        },
      ];
---

<Layout
  title={`${t('thanks_title')} | Duerre`}
  description={t('thanks_desc')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={lang === 'it' ? 'Trasmissione Completata' : 'Transmission Complete'}
    title={t('thanks_title')}
    subtitle={t('thanks_desc')}
  />

  <section class="py-24 md:py-36 px-6 sm:px-10">
    <div class="mx-auto max-w-[1440px]">
      <div class="grid md:grid-cols-3 gap-12 pb-20 border-b border-line/60" data-reveal>
        {nextSteps.map((step) => (
          <div>
            <span class="font-mono text-xs uppercase tracking-[0.26em] text-accent block mb-5">
              /{step.num}
            </span>
            <h2 class="text-2xl font-light tracking-tight text-ink mb-3">
              {step.title}
            </h2>
            <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
              {step.desc}
            </p>
          </div>
        ))}
      </div>

      <div class="pt-14 flex flex-wrap items-center justify-between gap-6" data-reveal>
        <div class="font-mono text-xs uppercase tracking-[0.22em] text-muted">
          DUERRE ATELIER · {SITE.email}
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={localePath(lang, '/')} class="btn-primary">
            <span>{t('thanks_back')}</span>
            <span>↗</span>
          </a>
          <a href={localePath(lang, '/portfolio/')} class="btn-ghost">
            <span>{t('hero_cta_primary')}</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
