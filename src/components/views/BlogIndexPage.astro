---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../PostPreview.astro';
import { Picture } from 'astro:assets';
import { getPosts, splitId, formatDate, readingMinutes } from '../../lib/content';
import { useTranslations, localePath, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allPosts = await getPosts(lang);
const featuredPost = allPosts.find(p => p.data.featured) || allPosts[0];
const gridPosts = allPosts.filter(p => p.id !== featuredPost?.id);

// Tag counts
const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  (post.data.tags || []).forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = Array.from(tagCounts.keys()).sort();
---

<BaseLayout 
  title={`${t('nav_blog')} | Duerremedia`} 
  description={t('blog_meta_desc')} 
  lang={lang}
>
  <div class="px-6 py-20 md:py-28 max-w-7xl mx-auto">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-mono uppercase tracking-[0.2em] text-accent block mb-3">Publication & Journal</span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6 text-ink">{t('nav_blog')}</h1>
      <p class="text-lg md:text-xl text-muted leading-relaxed">{t('blog_intro')}</p>
    </div>

    <!-- Featured Flagship Article Banner -->
    {featuredPost && (
      <div class="mb-16 md:mb-20 rounded-2xl overflow-hidden border border-line bg-surface/50 group hover:border-accent/50 transition-all duration-500">
        <div class="grid lg:grid-cols-12 items-center">
          <div class="lg:col-span-7 relative aspect-[16/9] lg:aspect-[16/10] overflow-hidden bg-surface media-zoom">
            <a href={localePath(lang, `/blog/${splitId(featuredPost.id).slug}/`)} class="block h-full w-full">
              <Picture 
                formats={['avif', 'webp']} 
                src={featuredPost.data.coverImage} 
                alt={featuredPost.data.coverAlt || featuredPost.data.title} 
                class="h-full w-full object-cover"
                widths={[600, 1000, 1400]}
                sizes="(max-width: 1024px) 100vw, 60vw"
                loading="eager"
              />
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-widest bg-black/75 backdrop-blur-md text-accent border border-white/10 font-bold">
                Featured Essay
              </span>
            </a>
          </div>

          <div class="lg:col-span-5 p-8 sm:p-10 lg:p-12 flex flex-col justify-center">
            <div class="flex items-center gap-3 text-xs text-muted mb-4 font-mono">
              <time datetime={featuredPost.data.pubDate.toISOString()}>
                {formatDate(featuredPost.data.pubDate, lang)}
              </time>
              <span>·</span>
              <span>{readingMinutes(featuredPost.body)} min read</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-4 group-hover:text-accent transition-colors">
              <a href={localePath(lang, `/blog/${splitId(featuredPost.id).slug}/`)}>
                {featuredPost.data.title}
              </a>
            </h2>

            <p class="text-muted text-sm sm:text-base leading-relaxed mb-6">
              {featuredPost.data.description}
            </p>

            {featuredPost.data.tags && (
              <div class="flex flex-wrap gap-2 mb-6">
                {featuredPost.data.tags.map(tag => (
                  <span class="px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wider rounded-full bg-surface border border-line text-muted">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <div>
              <a href={localePath(lang, `/blog/${splitId(featuredPost.id).slug}/`)} class="btn-primary text-xs py-3 px-6">
                Read Article →
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Category Filter Pills -->
    {sortedTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-12 items-center" id="blog-filters">
        <button 
          type="button" 
          data-tag="all" 
          class="blog-filter-pill active px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-colors bg-ink text-bg cursor-pointer"
        >
          {t('all_articles')} ({allPosts.length})
        </button>
        {sortedTags.map(tag => (
          <button 
            type="button" 
            data-tag={tag} 
            class="blog-filter-pill px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-colors bg-surface text-muted border border-line hover:border-ink hover:text-ink cursor-pointer"
          >
            {tag} ({tagCounts.get(tag)})
          </button>
        ))}
      </div>
    )}

    <!-- Articles Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12" id="blog-grid">
      {gridPosts.map(post => (
        <div class="blog-item transition-opacity duration-300" data-tags={(post.data.tags || []).join(',')}>
          <PostPreview post={post} />
        </div>
      ))}
    </div>
  </div>

  <script>
    function initBlogFilters() {
      const filterButtons = document.querySelectorAll('.blog-filter-pill');
      const blogItems = document.querySelectorAll('.blog-item');

      filterButtons.forEach((btn) => {
        (btn as HTMLButtonElement).onclick = () => {
          const selectedTag = (btn as HTMLElement).dataset.tag;

          filterButtons.forEach((b) => {
            b.classList.remove('bg-ink', 'text-bg');
            b.classList.add('bg-surface', 'text-muted', 'border', 'border-line');
          });
          btn.classList.add('bg-ink', 'text-bg');
          btn.classList.remove('bg-surface', 'text-muted', 'border', 'border-line');

          blogItems.forEach((item) => {
            const tags = ((item as HTMLElement).dataset.tags || '').split(',');
            if (selectedTag === 'all' || tags.includes(selectedTag!)) {
              item.classList.remove('hidden');
            } else {
              item.classList.add('hidden');
            }
          });
        };
      });
    }

    initBlogFilters();
    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</BaseLayout>

