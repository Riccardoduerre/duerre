---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../PostPreview.astro';
import { getPosts } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const allTags = Array.from(new Set(posts.flatMap(p => p.data.tags || []))).sort();
---

<BaseLayout 
  title={`${t('nav_blog')} | Duerre Media`} 
  description={t('blog_meta_desc')} 
  lang={lang}
>
  <div class="px-6 py-24 md:py-32 max-w-7xl mx-auto">
    <div class="max-w-3xl mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">{t('nav_blog')}</h1>
      <p class="text-xl text-muted">{t('blog_intro')}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12" id="blog-grid">
      {posts.map(post => (
        <div class="blog-item">
          <PostPreview post={post} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

