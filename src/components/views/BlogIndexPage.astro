---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import PostPreview from '../PostPreview.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { getPosts } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getPosts(lang);

const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = Array.from(tagCounts.keys()).sort();
---

<Layout
  title={`${t('nav_blog')} | Duerre`}
  description={t('blog_meta_desc')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('blog_breadcrumb_sub')}
    title={t('nav_blog')}
    subtitle={t('blog_page_heading')}
  />

  <section class="py-24 md:py-36 px-6 sm:px-10">
    <div class="mx-auto max-w-[1440px]">
      <!-- Editorial Topic Filter Bar -->
      {sortedTags.length > 0 && (
        <div
          class="flex flex-wrap gap-x-6 gap-y-3 pb-10 mb-16 border-b border-line/60 items-center"
          id="blog-filters"
          role="group"
          aria-label={t('filter_label')}
          data-reveal
        >
          <button
            type="button"
            data-tag="all"
            aria-pressed="true"
            class="blog-filter-pill active font-mono text-[11px] uppercase tracking-[0.22em] text-ink underline decoration-accent underline-offset-8 cursor-pointer transition-colors"
          >
            {t('all_articles')} [{allPosts.length}]
          </button>
          {sortedTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              aria-pressed="false"
              class="blog-filter-pill font-mono text-[11px] uppercase tracking-[0.22em] text-muted hover:text-ink cursor-pointer transition-colors"
            >
              {tag} [{tagCounts.get(tag)}]
            </button>
          ))}
        </div>
      )}

      <!-- Essays Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12" id="blog-grid">
        {allPosts.map((post) => (
          <div class="blog-item transition-opacity duration-500" data-tags={JSON.stringify(post.data.tags || [])}>
            <PostPreview post={post} lang={lang} headingTag="h2" />
          </div>
        ))}
      </div>

      <p
        id="blog-empty-state"
        class="hidden py-16 text-center font-mono text-xs uppercase tracking-[0.24em] text-muted"
        aria-live="polite"
      >
        {t('filter_empty')}
      </p>
    </div>
  </section>

  <DualCtaBanner lang={lang} />

  <script>
    function initBlogFilters() {
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.blog-filter-pill');
      const blogItems = document.querySelectorAll<HTMLElement>('.blog-item');
      const emptyState = document.getElementById('blog-empty-state');

      filterButtons.forEach((btn) => {
        btn.onclick = () => {
          const selectedTag = btn.dataset.tag;

          filterButtons.forEach((b) => {
            b.classList.remove('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
            b.classList.add('text-muted');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
          btn.classList.remove('text-muted');
          btn.setAttribute('aria-pressed', 'true');

          let visibleCount = 0;
          blogItems.forEach((item) => {
            let tags: string[] = [];
            try {
              tags = JSON.parse(item.dataset.tags || '[]');
            } catch {
              tags = [];
            }
            if (selectedTag === 'all' || (selectedTag && tags.includes(selectedTag))) {
              item.classList.remove('hidden');
              visibleCount++;
            } else {
              item.classList.add('hidden');
            }
          });

          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
          }
        };
      });
    }

    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</Layout>
