---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import PostPreview from '../PostPreview.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { getPosts } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allPosts = await getPosts(lang);

// Tag counts
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = Array.from(tagCounts.keys()).sort();
---

<BaseLayout
  title={`${t('nav_blog')} | Duerre`}
  description={t('blog_meta_desc')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('blog_breadcrumb_sub')}
    title={t('nav_blog')}
  />

  <section class="py-20 md:py-28 px-6 bg-grid-lines">
    <div class="mx-auto max-w-7xl">
      <!-- Intro Heading (communicationitalia.com/blog-communication-italia style) -->
      <div class="max-w-3xl mb-14">
        <span class="pill-subtext mb-4">{t('nav_blog')}</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.12] text-ink">
          {t('blog_page_heading')}
        </h2>
      </div>

      <!-- Category Filter Pills -->
      {sortedTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-14 items-center" id="blog-filters">
          <button
            type="button"
            data-tag="all"
            class="blog-filter-pill active px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-colors bg-ink text-bg cursor-pointer"
          >
            {t('all_articles')} ({allPosts.length})
          </button>
          {sortedTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="blog-filter-pill px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-colors bg-surface text-muted border border-line hover:border-ink hover:text-ink cursor-pointer"
            >
              {tag} ({tagCounts.get(tag)})
            </button>
          ))}
        </div>
      )}

      <!-- Articles Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10" id="blog-grid">
        {allPosts.map((post) => (
          <div class="blog-item transition-opacity duration-300" data-tags={(post.data.tags || []).join(',')}>
            <PostPreview post={post} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <DualCtaBanner lang={lang} />

  <script>
    function initBlogFilters() {
      const filterButtons = document.querySelectorAll('.blog-filter-pill');
      const blogItems = document.querySelectorAll('.blog-item');

      filterButtons.forEach((btn) => {
        (btn as HTMLButtonElement).onclick = () => {
          const selectedTag = (btn as HTMLElement).dataset.tag;

          filterButtons.forEach((b) => {
            b.classList.remove('bg-ink', 'text-bg');
            b.classList.add('bg-surface', 'text-muted', 'border', 'border-line');
          });
          btn.classList.add('bg-ink', 'text-bg');
          btn.classList.remove('bg-surface', 'text-muted', 'border', 'border-line');

          blogItems.forEach((item) => {
            const tags = ((item as HTMLElement).dataset.tags || '').split(',');
            if (selectedTag === 'all' || tags.includes(selectedTag!)) {
              item.classList.remove('hidden');
            } else {
              item.classList.add('hidden');
            }
          });
        };
      });
    }

    initBlogFilters();
    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</BaseLayout>
