---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import PostPreview from '../PostPreview.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { splitId, type Post } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const isVisible = (draft?: boolean) => import.meta.env.DEV || !draft;
const matchesLocale = (id: string) => {
  const parsed = splitId(id);
  return parsed.lang === lang || parsed.lang === 'shared';
};

const rawPosts = await getCollection(
  'blog',
  (entry: Post) => matchesLocale(entry.id) && isVisible(entry.data.draft),
);
const allPosts = rawPosts.sort(
  (a: Post, b: Post) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = Array.from(tagCounts.keys()).sort();
---

<Layout
  title={`${t('nav_blog')} | Duerre`}
  description={t('blog_meta_desc')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('blog_breadcrumb_sub')}
    title={t('nav_blog')}
    subtitle={t('blog_page_heading')}
  />

  <section class="py-24 md:py-36 px-6 sm:px-10">
    <div class="mx-auto max-w-[1440px]">
      <!-- Editorial Topic Filter Bar -->
      {sortedTags.length > 0 && (
        <div
          class="flex flex-wrap gap-x-6 gap-y-3 pb-10 mb-16 border-b border-line/60 items-center"
          id="blog-filters"
          data-reveal
        >
          <button
            type="button"
            data-tag="all"
            class="blog-filter-pill active font-mono text-[11px] uppercase tracking-[0.22em] text-ink underline decoration-accent underline-offset-8 cursor-pointer transition-colors"
          >
            {t('all_articles')} [{allPosts.length}]
          </button>
          {sortedTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="blog-filter-pill font-mono text-[11px] uppercase tracking-[0.22em] text-muted hover:text-ink cursor-pointer transition-colors"
            >
              {tag} [{tagCounts.get(tag)}]
            </button>
          ))}
        </div>
      )}

      <!-- Essays Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12" id="blog-grid">
        {allPosts.map((post) => (
          <div class="blog-item transition-opacity duration-500" data-tags={(post.data.tags || []).join(',')}>
            <PostPreview post={post} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <DualCtaBanner lang={lang} />

  <script>
    function initBlogFilters() {
      const filterButtons = document.querySelectorAll('.blog-filter-pill');
      const blogItems = document.querySelectorAll('.blog-item');

      filterButtons.forEach((btn) => {
        (btn as HTMLButtonElement).onclick = () => {
          const selectedTag = (btn as HTMLElement).dataset.tag;

          filterButtons.forEach((b) => {
            b.classList.remove('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
            b.classList.add('text-muted');
          });
          btn.classList.add('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
          btn.classList.remove('text-muted');

          blogItems.forEach((item) => {
            const tags = ((item as HTMLElement).dataset.tags || '').split(',');
            if (selectedTag === 'all' || tags.includes(selectedTag!)) {
              item.classList.remove('hidden');
            } else {
              item.classList.add('hidden');
            }
          });
        };
      });
    }

    initBlogFilters();
    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</Layout>
