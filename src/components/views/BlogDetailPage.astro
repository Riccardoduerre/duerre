---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { splitId, formatDate, readingMinutes, type Post } from '../../lib/content';
import { useTranslations, localePath, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { lang, post, prev, next } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(lang);
const mins = readingMinutes(post.body);
---

<BlogPostLayout 
  title={`${post.data.title} | Duerre Media`} 
  description={post.data.description} 
  lang={lang}
  image={post.data.coverImage.src}
>
  <header class="mb-12 text-center">
    <div class="flex items-center justify-center gap-x-4 text-sm text-muted mb-6">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate, lang)}
      </time>
      <span>&bull;</span>
      <span>{mins} min read</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold mb-6">{post.data.title}</h1>
    
    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap justify-center gap-2 mt-6">
        {post.data.tags.map(tag => (
          <span class="px-3 py-1 bg-surface border border-line rounded-full text-xs text-muted">{tag}</span>
        ))}
      </div>
    )}
  </header>

  <div class="mb-16 aspect-[16/9] rounded-xl overflow-hidden bg-surface">
    <Image 
      src={post.data.coverImage} 
      alt={post.data.coverAlt || post.data.title} 
      class="w-full h-full object-cover"
      width={1200}
      height={675}
    />
  </div>

  <div class="prose prose-studio prose-invert max-w-none">
    <Content />
  </div>

  <!-- Previous / Next Article Navigation -->
  {(prev || next) && (
    <nav aria-label="Article pagination" class="grid grid-cols-2 gap-6 py-12 border-t border-line my-12">
      <div>
        {prev && (
          <a href={localePath(lang, `/blog/${splitId(prev.id).slug}/`)} class="group block text-left">
            <span class="text-xs text-muted uppercase tracking-wider block mb-1">← {t('prev_post')}</span>
            <span class="text-base md:text-lg font-semibold group-hover:text-accent transition-colors">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a href={localePath(lang, `/blog/${splitId(next.id).slug}/`)} class="group block text-right">
            <span class="text-xs text-muted uppercase tracking-wider block mb-1">{t('next_post')} →</span>
            <span class="text-base md:text-lg font-semibold group-hover:text-accent transition-colors">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}
  
  <div class="mt-24 pt-12 border-t border-line text-center">
    <p class="text-muted mb-6">{t('post_cta_title')}</p>
    <a href={localePath(lang, '/contact/')} class="btn-primary">{t('nav_cta')}</a>
  </div>
</BlogPostLayout>
