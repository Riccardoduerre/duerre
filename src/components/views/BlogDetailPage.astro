---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CmsPicture from '../CmsPicture.astro';
import PostPreview from '../PostPreview.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { getPosts, splitId, formatDate, readingMinutes, imageUrl, type Post } from '../../lib/content';
import { useTranslations, localePath, type Locale } from '../../i18n';

import authorPortrait from '../../assets/media/DSCN7050.webp';

interface Props {
  lang: Locale;
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { lang, post, prev, next } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(lang);
const mins = readingMinutes(post.body);

const allPosts = await getPosts(lang);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && (p.data.tags || []).some((tag) => (post.data.tags || []).includes(tag)))
  .slice(0, 2);

const categoryLabels: Record<string, { it: string; en: string }> = {
  'cinema-video': { it: 'Cinema & Video Production', en: 'Cinema & Video Production' },
  fotografia: { it: 'Fotografia Commerciale', en: 'Commercial Photography' },
  '3d-cgi': { it: '3D & CGI Rendering', en: '3D & CGI Rendering' },
  'brand-direction': { it: 'Digital Brand Direction', en: 'Digital Brand Direction' },
  'dietro-le-quinte': { it: 'Behind the Scenes & Gear', en: 'Behind the Scenes & Gear' },
};
const categoryLabel =
  post.data.category && categoryLabels[post.data.category]
    ? categoryLabels[post.data.category][lang]
    : null;
---

<Layout
  title={`${post.data.title} | Duerre`}
  description={post.data.description}
  lang={lang}
  image={imageUrl(post.data.coverImage)}
  imageAlt={post.data.coverAlt || post.data.title}
  type="article"
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress"
    aria-hidden="true"
    class="fixed top-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-accent z-50 transition-transform duration-75 pointer-events-none"
  ></div>

  <article class="pt-16 md:pt-28 pb-24">
    <!-- 01. EDITORIAL MONOGRAPH HEADER (Above the fold: no data-reveal opacity delay) -->
    <header class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-14 md:mb-20">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
        <a
          href={localePath(lang, '/blog/')}
          class="inline-flex items-center gap-2 text-ink hover:text-accent transition-colors"
        >
          <span aria-hidden="true">←</span>
          <span>{t('nav_blog')}</span>
        </a>
        <div class="flex items-center gap-4">
          {categoryLabel && (
            <span class="border border-line/70 px-3 py-1 text-accent">
              {categoryLabel}
            </span>
          )}
          <button
            id="copy-link-btn"
            type="button"
            class="hover:text-accent transition-colors flex items-center gap-2 cursor-pointer"
            data-copied-text={t('link_copied')}
          >
            <span id="copy-btn-label">{t('copy_link')}</span>
            <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-end mb-14">
        <div class="lg:col-span-9">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-6">
            <time datetime={post.data.publishDate.toISOString()} class="text-accent">
              {formatDate(post.data.publishDate, lang)}
            </time>
            <span aria-hidden="true">/</span>
            <span>{mins} MIN READ</span>
            {post.data.tags.map((tag) => (
              <>
                <span aria-hidden="true">·</span>
                <span>{tag}</span>
              </>
            ))}
          </div>

          <h1 class="display-editorial text-ink">
            {post.data.title}
          </h1>
        </div>

        <div class="lg:col-span-3">
          <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
            {post.data.description}
          </p>
        </div>
      </div>
    </header>

    <!-- 02. HIGH-IMPACT WIDESCREEN HERO IMAGE (Above the fold: no data-reveal opacity delay) -->
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-20 md:mb-28">
      <div class="aspect-[16/9] md:aspect-[21/9] overflow-hidden bg-surface">
        <CmsPicture
          src={post.data.coverImage}
          alt={post.data.coverAlt || post.data.title}
          class="w-full h-full object-cover"
          widths={[800, 1400, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- 03. SCANNABLE EDITORIAL ESSAY GRID -->
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20">
      <!-- Left 4 Cols: Sticky Author & Monograph Telemetry -->
      <aside class="lg:col-span-4 space-y-10 lg:sticky lg:top-28 self-start" data-reveal>
        <div class="border-t border-line/60 pt-6">
          <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
            AUTHOR & DIRECTION
          </span>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 overflow-hidden bg-surface shrink-0">
              <Picture
                formats={['avif', 'webp']}
                src={authorPortrait}
                alt="Riccardo Riva"
                class="w-full h-full object-cover"
                widths={[120, 240]}
                sizes="56px"
              />
            </div>
            <div>
              <h2 class="text-base font-medium text-ink">Riccardo Riva</h2>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                Founder · Duerre
              </span>
            </div>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed">
            {lang === 'it'
              ? 'Direttore visivo, fotografo commerciale e 3D artist presso Duerre. Specializzato in color science ACES, cinematografia anamorfica e rendering fisico PBR.'
              : 'Visual director, commercial photographer, and 3D artist at Duerre. Specializing in ACES color science, anamorphic cinematography, and PBR rendering.'}
          </p>
        </div>

        {post.data.tags.length > 0 && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted block mb-4">
              TOPICS
            </span>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="border border-line/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </aside>

      <!-- Right 8 Cols: Immersive Markdown Essay -->
      <div class="lg:col-span-8">
        <div class="prose prose-studio prose-lg max-w-none font-light leading-relaxed" data-reveal>
          <Content />
        </div>

        <!-- Previous / Next Essay Pagination -->
        {(prev || next) && (
          <nav
            aria-label="Article pagination"
            class="grid sm:grid-cols-2 gap-8 py-14 border-t border-line/60 mt-20"
            data-reveal
          >
            <div>
              {prev && (
                <a href={localePath(lang, `/blog/${splitId(prev.id).slug}/`)} class="group block">
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    <span aria-hidden="true">←</span> {t('prev_post')}
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {prev.data.title}
                  </span>
                </a>
              )}
            </div>
            <div class="sm:text-right">
              {next && (
                <a href={localePath(lang, `/blog/${splitId(next.id).slug}/`)} class="group block">
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    {t('next_post')} <span aria-hidden="true">→</span>
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {next.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>
    </div>

    <!-- Related Reading -->
    {relatedPosts.length > 0 && (
      <section class="mx-auto max-w-[1440px] px-6 sm:px-10 mt-24 pt-16 border-t border-line/60">
        <h2 class="pill-subtext mb-12">{t('related_posts')}</h2>
        <div class="grid md:grid-cols-2 gap-10 lg:gap-14">
          {relatedPosts.map((p) => (
            <PostPreview post={p} lang={lang} />
          ))}
        </div>
      </section>
    )}
  </article>

  <DualCtaBanner lang={lang} />

  <script>
    let blogScrollController: AbortController | null = null;

    function cleanupBlogEnhancements() {
      blogScrollController?.abort();
      blogScrollController = null;
    }

    function initBlogEnhancements() {
      cleanupBlogEnhancements();
      const bar = document.getElementById('reading-progress');
      if (bar) {
        blogScrollController = new AbortController();
        let ticking = false;
        const updateProgress = () => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = totalHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / totalHeight)) : 0;
          bar.style.transform = `scaleX(${ratio})`;
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              window.requestAnimationFrame(updateProgress);
              ticking = true;
            }
          },
          { passive: true, signal: blogScrollController.signal },
        );
        updateProgress();
      }

      const copyBtn = document.getElementById('copy-link-btn');
      const copyLabel = document.getElementById('copy-btn-label');
      if (copyBtn && copyLabel) {
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const originalText = copyLabel.textContent;
            copyLabel.textContent = copyBtn.dataset.copiedText || 'Copied!';
            setTimeout(() => {
              copyLabel.textContent = originalText;
            }, 2000);
          } catch {
            // ignore
          }
        };
      }
    }

    document.addEventListener('astro:before-swap', cleanupBlogEnhancements);
    document.addEventListener('astro:page-load', initBlogEnhancements);
  </script>
</Layout>
