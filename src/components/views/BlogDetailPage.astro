---
import { render, getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PostPreview from '../PostPreview.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { splitId, formatDate, readingMinutes, type Post } from '../../lib/content';
import { useTranslations, localePath, type Locale } from '../../i18n';

import authorPortrait from '../../assets/blog/DSCN7050.webp';

interface Props {
  lang: Locale;
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { lang, post, prev, next } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(lang);
const mins = readingMinutes(post.body);

const isVisible = (draft?: boolean) => import.meta.env.DEV || !draft;
const matchesLocale = (id: string) => {
  const parsed = splitId(id);
  return parsed.lang === lang || parsed.lang === 'shared';
};

const rawPosts = await getCollection(
  'blog',
  (entry: Post) => matchesLocale(entry.id) && isVisible(entry.data.draft),
);
const allPosts = rawPosts.sort(
  (a: Post, b: Post) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && (p.data.tags || []).some((tag) => (post.data.tags || []).includes(tag)))
  .slice(0, 2);
---

<Layout
  title={`${post.data.title} | Duerre`}
  description={post.data.description}
  lang={lang}
  image={post.data.coverImage.src}
  type="article"
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-[2px] bg-accent z-50 transition-all duration-75 w-0 pointer-events-none"
  />

  <article class="pt-16 md:pt-28 pb-24">
    <!-- 01. EDITORIAL MONOGRAPH HEADER -->
    <header class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-14 md:mb-20" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
        <a
          href={localePath(lang, '/blog/')}
          class="inline-flex items-center gap-2 text-ink hover:text-accent transition-colors"
        >
          <span>←</span>
          <span>{t('nav_blog')}</span>
        </a>
        <button
          id="copy-link-btn"
          type="button"
          class="hover:text-accent transition-colors flex items-center gap-2 cursor-pointer"
          data-copied-text={t('link_copied')}
        >
          <span id="copy-btn-label">{t('copy_link')}</span>
          <span>↗</span>
        </button>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-end mb-14">
        <div class="lg:col-span-9">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-6">
            <time datetime={post.data.publishDate.toISOString()} class="text-accent">
              {formatDate(post.data.publishDate, lang)}
            </time>
            <span>/</span>
            <span>{mins} MIN READ</span>
            {post.data.tags.map((tag) => (
              <>
                <span>·</span>
                <span>{tag}</span>
              </>
            ))}
          </div>

          <h1 class="display-editorial text-ink">
            {post.data.title}
          </h1>
        </div>

        <div class="lg:col-span-3">
          <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
            {post.data.description}
          </p>
        </div>
      </div>
    </header>

    <!-- 02. HIGH-IMPACT WIDESCREEN HERO IMAGE -->
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-20 md:mb-28" data-reveal>
      <div class="aspect-[16/9] md:aspect-[21/9] overflow-hidden bg-surface">
        <Picture
          formats={['avif', 'webp']}
          src={post.data.coverImage}
          alt={post.data.coverAlt || post.data.title}
          class="w-full h-full object-cover"
          widths={[800, 1400, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- 03. SCANNABLE EDITORIAL ESSAY GRID -->
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20">
      <!-- Left 4 Cols: Sticky Author & Monograph Telemetry -->
      <aside class="lg:col-span-4 space-y-10 lg:sticky lg:top-28 self-start" data-reveal>
        <div class="border-t border-line/60 pt-6">
          <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
            AUTHOR & DIRECTION
          </span>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 overflow-hidden bg-surface shrink-0">
              <Picture
                formats={['avif', 'webp']}
                src={authorPortrait}
                alt="Riccardo Riva"
                class="w-full h-full object-cover"
                widths={[120, 240]}
                sizes="56px"
              />
            </div>
            <div>
              <h3 class="text-base font-medium text-ink">Riccardo Riva</h3>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                Founder · Duerre
              </span>
            </div>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed">
            {lang === 'it'
              ? 'Direttore visivo, fotografo commerciale e 3D artist presso Duerre. Specializzato in color science ACES, cinematografia anamorfica e rendering fisico PBR.'
              : 'Visual director, commercial photographer, and 3D artist at Duerre. Specializing in ACES color science, anamorphic cinematography, and PBR rendering.'}
          </p>
        </div>

        {post.data.tags.length > 0 && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted block mb-4">
              TOPICS
            </span>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="border border-line/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </aside>

      <!-- Right 8 Cols: Immersive Markdown Essay -->
      <div class="lg:col-span-8">
        <div class="prose prose-studio prose-lg max-w-none font-light leading-relaxed" data-reveal>
          <Content />
        </div>

        <!-- Previous / Next Essay Pagination -->
        {(prev || next) && (
          <nav
            aria-label="Article pagination"
            class="grid sm:grid-cols-2 gap-8 py-14 border-t border-line/60 mt-20"
            data-reveal
          >
            <div>
              {prev && (
                <a href={localePath(lang, `/blog/${splitId(prev.id).slug}/`)} class="group block">
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    ← {t('prev_post')}
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {prev.data.title}
                  </span>
                </a>
              )}
            </div>
            <div class="sm:text-right">
              {next && (
                <a href={localePath(lang, `/blog/${splitId(next.id).slug}/`)} class="group block">
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    {t('next_post')} →
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {next.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>
    </div>

    <!-- Related Reading -->
    {relatedPosts.length > 0 && (
      <section class="mx-auto max-w-[1440px] px-6 sm:px-10 mt-24 pt-16 border-t border-line/60">
        <span class="pill-subtext mb-12">{t('related_posts')}</span>
        <div class="grid md:grid-cols-2 gap-10 lg:gap-14">
          {relatedPosts.map((p) => (
            <PostPreview post={p} lang={lang} />
          ))}
        </div>
      </section>
    )}
  </article>

  <DualCtaBanner lang={lang} />

  <script>
    function setupPostInteractions() {
      const bar = document.getElementById('reading-progress');
      if (bar) {
        window.onscroll = () => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
          bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
        };
      }

      const copyBtn = document.getElementById('copy-link-btn');
      const copyLabel = document.getElementById('copy-btn-label');
      if (copyBtn && copyLabel) {
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const originalText = copyLabel.textContent;
            copyLabel.textContent = copyBtn.dataset.copiedText || 'Copied!';
            setTimeout(() => {
              copyLabel.textContent = originalText;
            }, 2000);
          } catch {
            // ignore
          }
        };
      }
    }

    setupPostInteractions();
    document.addEventListener('astro:page-load', setupPostInteractions);
  </script>
</Layout>
