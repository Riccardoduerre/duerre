---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';
import { CONTACT_FORM, contactFormMode, SITE } from '../../config/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const mode = contactFormMode();
---

<BaseLayout 
  title={`${t('nav_contact')} | Duerremedia`} 
  description={t('contact_title')} 
  lang={lang}
>
  <div class="max-w-4xl mx-auto px-6 py-20 md:py-28">
    <!-- Header with Live Studio Availability HUD -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-line text-[11px] font-mono uppercase tracking-wider text-muted mb-6">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Italy (CET) · Accepting commissions</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-4 text-ink">{t('contact_title')}</h1>
      <p class="text-muted text-base sm:text-lg max-w-2xl leading-relaxed">{t('project_cta_desc')}</p>
    </div>

    <!-- Direct Email Quick Card -->
    <div class="mb-12 p-6 rounded-2xl bg-surface/60 border border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-[11px] font-mono text-muted uppercase tracking-wider block mb-1">Direct Studio Dispatch</span>
        <a href={`mailto:${SITE.email}`} class="text-base sm:text-lg font-semibold text-ink hover:text-accent transition-colors">
          {SITE.email}
        </a>
      </div>
      <button 
        id="copy-contact-email" 
        type="button" 
        class="btn-ghost text-xs py-2.5 px-5 self-start sm:self-auto cursor-pointer"
        data-copied-text={t('link_copied')}
      >
        <span id="copy-email-label">Copy Email Address</span>
      </button>
    </div>

    {mode === 'mailto' ? (
      <div class="bg-surface/70 border border-line rounded-2xl p-8 sm:p-12 text-center">
        <h3 class="text-xl font-bold mb-3 text-ink">Prefer writing an email directly?</h3>
        <p class="text-muted text-sm mb-8 max-w-lg mx-auto leading-relaxed">
          {t('contact_form_fallback_note')} <a href={`mailto:${SITE.email}`} class="text-accent underline underline-offset-4">{SITE.email}</a>.
        </p>
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(t('contact_form_subject'))}`} class="btn-primary">
          {t('open_email_app')} →
        </a>
      </div>
    ) : (
      <form action={CONTACT_FORM.action} method="POST" class="space-y-6 bg-surface/40 p-8 sm:p-10 rounded-2xl border border-line">
        {mode === 'web3forms' && <input type="hidden" name="access_key" value={CONTACT_FORM.accessKey} />}
        <input type="hidden" name="subject" value={t('contact_form_subject')} />
        <input type="hidden" name="redirect" value={`${Astro.url.origin}${localePath(lang, '/thanks/')}`} />
        
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">{t('label_name')}</label>
            <input type="text" id="name" name="name" required class="field" placeholder="Jane Doe" />
          </div>
          <div>
            <label for="email" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">{t('label_email')}</label>
            <input type="email" id="email" name="email" required class="field" placeholder="jane@brand.com" />
          </div>
        </div>
        
        <div>
          <label for="budget" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">{t('contact_form_budget')}</label>
          <input type="text" id="budget" name="budget" placeholder={t('contact_form_budget_placeholder')} class="field" />
        </div>
        
        <div>
          <label for="message" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">{t('label_message')}</label>
          <textarea id="message" name="message" required rows="6" class="field resize-y" placeholder="Tell me about the project goals, timeline, and scope..."></textarea>
        </div>

        <button type="submit" class="btn-primary w-full sm:w-auto">{t('label_send')} →</button>
      </form>
    )}
  </div>

  <script>
    function initContactCopy() {
      const copyBtn = document.getElementById('copy-contact-email');
      const copyLabel = document.getElementById('copy-email-label');
      if (copyBtn && copyLabel) {
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText('riccardo@duerremedia.com');
            const originalText = copyLabel.textContent;
            copyLabel.textContent = copyBtn.dataset.copiedText || 'Copied!';
            setTimeout(() => {
              copyLabel.textContent = originalText;
            }, 2000);
          } catch {
            // fallback
          }
        };
      }
    }

    initContactCopy();
    document.addEventListener('astro:page-load', initContactCopy);
  </script>
</BaseLayout>

