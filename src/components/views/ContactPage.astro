---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';
import { CONTACT_FORM, contactFormMode, SITE } from '../../config/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const mode = contactFormMode();
const thanksUrl = `${Astro.url.origin}${localePath(lang, '/thanks/')}`;
const thanksPath = localePath(lang, '/thanks/');

const serviceOptions = [
  t('service_1_title'),
  t('service_2_title'),
  t('service_3_title'),
  t('service_4_title'),
];
---

<Layout
  title={`${t('nav_contact')} | Duerre`}
  description={t('contact_title')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('contact_breadcrumb_sub')}
    title={t('nav_contact')}
    subtitle={t('contact_title')}
  />

  <section class="py-24 md:py-40 px-6 sm:px-10">
    <div class="mx-auto max-w-[1440px] grid lg:grid-cols-12 gap-16 lg:gap-24 items-start">
      <!-- Left 5 Cols: Direct Atelier Coordinates -->
      <div class="lg:col-span-5 space-y-12" data-reveal>
        <div>
          <span class="pill-subtext mb-6">01 / DIRECT COORDINATES</span>
          <h2 class="display-section text-ink mb-6">
            {t('contact_title')}
          </h2>
          <p class="text-base sm:text-lg font-light text-muted leading-relaxed">
            {t('project_cta_desc')}
          </p>
        </div>

        <div class="border-t border-line/60 pt-8 space-y-4">
          <span class="font-mono text-[10px] text-accent uppercase tracking-[0.26em] block">
            DIRECT ELECTRONIC MAIL
          </span>
          <a
            href={`mailto:${SITE.email}`}
            class="block text-2xl sm:text-3xl font-light tracking-tight text-ink hover:text-accent transition-colors break-all"
          >
            {SITE.email}
          </a>
          <div class="pt-2">
            <button
              id="copy-contact-email"
              type="button"
              class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted hover:text-ink underline underline-offset-4 cursor-pointer"
              data-copied-text={t('link_copied')}
            >
              <span id="copy-email-label">{t('copy_link')}: {SITE.email}</span>
            </button>
          </div>
        </div>

        <div class="border-t border-line/60 pt-8 space-y-4">
          <div class="inline-flex items-center gap-2.5 font-mono text-[10px] uppercase tracking-[0.24em] text-ink">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>
              {SITE.location} · {lang === 'it' ? 'Disponibile per nuove commissioni' : 'Accepting Commissions'}
            </span>
          </div>
          <p class="text-sm font-light text-muted leading-relaxed">
            {t('service_1_title')} · {t('service_2_title')} · {t('service_3_title')} · {t('service_4_title')}
          </p>
        </div>
      </div>

      <!-- Right 7 Cols: Minimalist Editorial Commission Form -->
      <div class="lg:col-span-7" data-reveal>
        <form
          id="contact-request-form"
          action={CONTACT_FORM.action}
          method="POST"
          data-mode={mode}
          data-ajax-action={CONTACT_FORM.ajaxAction}
          data-recipient={SITE.email}
          data-subject={t('contact_form_subject')}
          data-thanks-path={thanksPath}
          class="space-y-10 border-t border-line/60 pt-10"
        >
          <div>
            <span class="pill-subtext mb-4">02 / {t('nav_cta')}</span>
            <h3 class="text-2xl sm:text-4xl font-light text-ink tracking-tight">
              {lang === 'it' ? 'Trasmetti il tuo brief di progetto' : 'Transmit your project brief'}
            </h3>
          </div>

          {mode === 'web3forms' && <input type="hidden" name="access_key" value={CONTACT_FORM.accessKey} />}
          <input type="hidden" name="_subject" value={t('contact_form_subject')} />
          <input type="hidden" name="_template" value="box" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={thanksUrl} />
          <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid md:grid-cols-2 gap-10">
            <div>
              <label for="name" class="block font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-2">
                {t('label_name')} *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="field"
                placeholder={lang === 'it' ? 'Mario Rossi' : 'Jane Doe'}
              />
            </div>
            <div>
              <label for="email" class="block font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-2">
                {t('label_email')} *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="field"
                placeholder={lang === 'it' ? 'nome@azienda.it' : 'jane@brand.com'}
              />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-10">
            <div>
              <label for="company" class="block font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-2">
                {lang === 'it' ? 'Maison / Azienda (facoltativo)' : 'Maison / Brand (optional)'}
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="field"
                placeholder={lang === 'it' ? 'Nome Azienda o Studio' : 'Brand or Studio Name'}
              />
            </div>
            <div>
              <label for="budget" class="block font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-2">
                {t('contact_form_budget')}
              </label>
              <input
                type="text"
                id="budget"
                name="budget"
                placeholder={t('contact_form_budget_placeholder')}
                class="field"
              />
            </div>
          </div>

          <div>
            <span class="block font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-4">
              {lang === 'it' ? 'Discipline richieste' : 'Requested Disciplines'}
            </span>
            <div class="flex flex-wrap gap-3">
              {serviceOptions.map((service) => (
                <label class="cursor-pointer select-none">
                  <input
                    type="checkbox"
                    name="services"
                    value={service}
                    class="peer sr-only"
                  />
                  <span class="inline-flex items-center px-4 py-2.5 border border-line/80 font-mono text-[10px] uppercase tracking-[0.2em] text-muted transition-all peer-checked:bg-ink peer-checked:text-bg peer-checked:border-ink hover:border-ink">
                    {service}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div>
            <label for="message" class="block font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-2">
              {t('label_message')} *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="field resize-y"
              placeholder={
                lang === 'it'
                  ? 'Descrivi gli obiettivi visivi, le tempistiche e i deliverables desiderati...'
                  : 'Outline your visual objectives, timeline, and desired deliverables...'
              }
            ></textarea>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <button
              id="contact-submit-btn"
              type="submit"
              data-default-label={`${t('label_send')} ↗`}
              data-sending-label={lang === 'it' ? 'Trasmissione in corso...' : 'Transmitting...'}
              class="btn-primary w-full sm:w-auto cursor-pointer disabled:opacity-60"
            >
              {t('label_send')} ↗
            </button>
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">
              {lang === 'it' ? 'Risposta diretta entro 24–48 ore' : 'Direct response within 24–48 hours'}
            </span>
          </div>

          <div
            id="contact-dispatch-feedback"
            class="hidden border border-line/80 bg-surface p-6 space-y-3"
            aria-live="polite"
          >
            <div class="flex items-center justify-between gap-3 flex-wrap">
              <p class="text-sm font-medium text-ink">
                {lang === 'it'
                  ? '✓ Brief pronto. Abbiamo aperto il tuo client email con i dettagli formattati.'
                  : '✓ Brief ready. Your email client has been opened with your formatted inquiry.'}
              </p>
              <button
                type="button"
                id="copy-compiled-brief"
                class="btn-ghost text-xs py-2 px-4 cursor-pointer"
                data-copied-label={lang === 'it' ? 'Brief copiato!' : 'Brief copied!'}
              >
                {lang === 'it' ? 'Copia testo del brief' : 'Copy formatted brief'}
              </button>
            </div>
            <p class="text-xs text-muted">
              {lang === 'it'
                ? 'Se non usi un’app email predefinita, copia il brief qui sopra e invialo a '
                : 'If your email app did not open automatically, copy the brief above and send it to '}
              <a href={`mailto:${SITE.email}`} class="text-ink font-semibold underline underline-offset-4">
                {SITE.email}
              </a>.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    function initContactPage() {
      const copyBtn = document.getElementById('copy-contact-email');
      const copyLabel = document.getElementById('copy-email-label');
      if (copyBtn && copyLabel) {
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText('riccardo@duerremedia.com');
            const originalText = copyLabel.textContent;
            copyLabel.textContent = copyBtn.dataset.copiedText || 'Copied!';
            setTimeout(() => {
              copyLabel.textContent = originalText;
            }, 2000);
          } catch {
            // ignore
          }
        };
      }

      const form = document.getElementById('contact-request-form') as HTMLFormElement | null;
      const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
      const feedbackBox = document.getElementById('contact-dispatch-feedback');
      const copyBriefBtn = document.getElementById('copy-compiled-brief') as HTMLButtonElement | null;

      if (!form) return;

      let latestBriefText = '';

      form.onsubmit = async (e) => {
        const mode = form.dataset.mode || 'formsubmit';
        if (mode === 'web3forms' || mode === 'formspree') {
          return;
        }

        e.preventDefault();
        const formData = new FormData(form);
        if (formData.get('_honey')) return;

        const name = ((formData.get('name') as string) || '').trim();
        const email = ((formData.get('email') as string) || '').trim();
        const company = ((formData.get('company') as string) || '').trim();
        const budget = ((formData.get('budget') as string) || '').trim();
        const message = ((formData.get('message') as string) || '').trim();
        const services = formData.getAll('services').map((s) => String(s));

        const recipient = form.dataset.recipient || 'riccardo@duerremedia.com';
        const baseSubject = form.dataset.subject || 'New inquiry from duerremedia.com';
        const thanksPath = form.dataset.thanksPath || '/thanks/';
        const ajaxAction = form.dataset.ajaxAction || 'https://formsubmit.co/ajax/b3c0b49afe301d86d6a62a3f768735fd';

        const subject = company ? `${baseSubject} — ${name} (${company})` : `${baseSubject} — ${name}`;

        const lines = [
          `Name: ${name}`,
          `Email: ${email}`,
          company ? `Company / Brand: ${company}` : '',
          services.length > 0 ? `Services: ${services.join(', ')}` : '',
          budget ? `Budget: ${budget}` : '',
          '',
          'Project Brief:',
          message,
        ].filter((line, idx, arr) => line !== '' || arr[idx - 1] !== '');

        latestBriefText = lines.join('\n');

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = submitBtn.dataset.sendingLabel || 'Sending...';
        }

        if (mode === 'formsubmit') {
          try {
            const response = await fetch(ajaxAction, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                name,
                email,
                _replyto: email,
                company: company || '—',
                services: services.length > 0 ? services.join(', ') : '—',
                budget: budget || '—',
                message,
                _subject: subject,
                _template: 'box',
              }),
            });

            const result = await response.json().catch(() => null);
            if (response.ok && result && (result.success === 'true' || result.success === true)) {
              window.location.href = thanksPath;
              return;
            }
            if (result && typeof result.message === 'string' && /activat|confirm/i.test(result.message)) {
              HTMLFormElement.prototype.submit.call(form);
              return;
            }
          } catch {
            // fall through to mailto
          }
        }

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitBtn.dataset.defaultLabel || 'Send Message ↗';
        }

        const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(latestBriefText)}`;
        window.location.href = mailtoUrl;

        if (feedbackBox) {
          feedbackBox.classList.remove('hidden');
        }
      };

      if (copyBriefBtn) {
        copyBriefBtn.onclick = async () => {
          if (!latestBriefText) return;
          try {
            await navigator.clipboard.writeText(latestBriefText);
            const original = copyBriefBtn.textContent;
            copyBriefBtn.textContent = copyBriefBtn.dataset.copiedLabel || 'Copied!';
            setTimeout(() => {
              copyBriefBtn.textContent = original;
            }, 2000);
          } catch {
            // ignore
          }
        };
      }
    }

    initContactPage();
    document.addEventListener('astro:page-load', initContactPage);
  </script>
</Layout>
