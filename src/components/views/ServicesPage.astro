---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import FaqAccordion from '../FaqAccordion.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';

import imgPhoto from '../../assets/blog/Giau_00001.webp';
import imgVideo from '../../assets/blog/_DSC2365.webp';
import img3d from '../../assets/blog/Giau_00004.webp';
import imgMarketing from '../../assets/blog/Landscapes_00003.webp';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    id: 'commercial-photography',
    num: '01',
    title: 'COMMERCIAL PHOTOGRAPHY',
    desc: t('service_1_desc'),
    img: imgPhoto,
    bullets:
      lang === 'it'
        ? [
            'Still life di prodotto e campagne e-commerce ad alta risoluzione',
            'Fotografia d’architettura, hospitality e corporate reportage',
            'Gestione luce da studio, negative fill e controllo riflessi speculari',
            'Post-produzione avanzata e profilo colore calibrato per web e stampa',
          ]
        : [
            'High-resolution product still life and e-commerce campaigns',
            'Architectural, hospitality, and corporate editorial photography',
            'Precision studio lighting, negative fill, and specular highlight control',
            'High-end retouching and calibrated color delivery for web & print',
          ],
  },
  {
    id: 'cinema-video-production',
    num: '02',
    title: 'CINEMA & VIDEO PRODUCTION',
    desc: t('service_2_desc'),
    img: imgVideo,
    bullets:
      lang === 'it'
        ? [
            'Spot commerciali, brand film e video corporate',
            'Regia, direzione della fotografia e movimenti camera motivati',
            'Riprese in formato Log/RAW ad alta gamma dinamica',
            'Montaggio narrativo, sound design e color grading in pipeline ACES',
          ]
        : [
            'Commercial spots, brand films, and corporate video production',
            'Direction, cinematography, and motivated camera movement',
            'High-dynamic-range Log/RAW cinema capture',
            'Editorial pacing, sound architecture, and ACES color grading',
          ],
  },
  {
    id: '3d-cgi-rendering',
    num: '03',
    title: '3D CGI & PRODUCT RENDERING',
    desc: t('service_3_desc'),
    img: img3d,
    bullets:
      lang === 'it'
        ? [
            'Rendering 3D fotorealistici di prodotto per lanci e pre-produzione',
            'Shading PBR, micro-texture e illuminazione virtuale HDRI da studio',
            'Animazioni 3D di prodotto ed esplosi tecnici',
            'Compositing multipass EXR 32-bit perfettamente integrato',
          ]
        : [
            'Photorealistic 3D product renders for pre-launch and campaigns',
            'Physically based PBR shading, micro-surface detail, and studio HDRI lighting',
            '3D product animations and technical motion reveals',
            '32-bit EXR multi-pass AOV compositing pipeline',
          ],
  },
  {
    id: 'digital-marketing',
    num: '04',
    title: 'DIGITAL MARKETING',
    desc: t('service_4_desc'),
    img: imgMarketing,
    bullets:
      lang === 'it'
        ? [
            'Strategia digitale integrata e direzione creativa per i social media',
            'Creazione di contenuti verticali e campagne visual ad alta conversione',
            'Ottimizzazione SEO e posizionamento del brand online',
            'Pianificazione editoriale e analisi delle performance delle campagne',
          ]
        : [
            'Integrated digital strategy and social media creative direction',
            'High-converting visual assets and vertical short-form campaigns',
            'SEO optimization and online brand positioning',
            'Editorial content planning and campaign performance analysis',
          ],
  },
];

const faqItems =
  lang === 'it'
    ? [
        {
          question: 'Perché scegliere Duerre come partner unico per la produzione visiva e comunicazione?',
          answer:
            'Perché uniamo competenze verticali in fotografia commerciale, produzione video, 3D CGI e digital marketing. Questo ci permette di seguire ogni fase del progetto senza dispersioni, garantendo coerenza estetica e strategica su tutti i canali.',
        },
        {
          question: 'Posso richiedere un singolo servizio o solo progetti integrati?',
          answer:
            'Entrambe le opzioni sono possibili. Puoi affidarci una singola produzione (ad esempio uno shooting fotografico, un render 3D o un video corporate) oppure costruire insieme un percorso continuativo che integra contenuti visivi e digital marketing.',
        },
        {
          question: 'Lavorate anche con piccole e medie imprese o solo con grandi brand?',
          answer:
            'Collaboriamo con realtà di ogni dimensione: dalle PMI e professionisti che vogliono fare un salto di qualità nella propria immagine, fino a brand strutturati e agenzie che cercano una direzione visiva e tecnica d’eccellenza.',
        },
      ]
    : [
        {
          question: 'Why choose Duerre as a single partner for visual production and digital communication?',
          answer:
            'Because we combine vertical expertise across commercial photography, cinema production, 3D CGI rendering, and digital marketing. This allows us to oversee every stage of your project seamlessly, ensuring visual and strategic consistency across every touchpoint.',
        },
        {
          question: 'Can I request a single service or only full-package campaigns?',
          answer:
            'Both options are available. You can commission a standalone production (such as a product photography shoot, 3D CGI rendering, or a brand film) or partner with us for an integrated package combining visual production and digital marketing.',
        },
        {
          question: 'Do you work with small and medium businesses as well as established brands?',
          answer:
            'We partner with ambitious businesses of every size — from growing SMEs and studios looking to elevate their brand identity to established companies seeking cinema-grade visual production.',
        },
      ];
---

<BaseLayout
  title={`${t('nav_services')} | Duerre`}
  description={t('services_desc')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('services_eyebrow')}
    title={t('nav_services')}
  />

  <!-- Interactive Overview List (communicationitalia.com/servizi style) -->
  <section class="py-24 md:py-32 px-6 bg-grid-lines border-b border-line">
    <div class="mx-auto max-w-7xl">
      <div class="grid lg:grid-cols-12 gap-10 items-end mb-16">
        <div class="lg:col-span-7">
          <span class="pill-subtext mb-5">{t('services_eyebrow')}</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] text-ink">
            {t('services_page_subtitle')}
          </h2>
        </div>
        <div class="lg:col-span-5">
          <p class="text-base sm:text-lg text-muted leading-relaxed">
            {t('services_desc')}
          </p>
        </div>
      </div>

      <!-- 4 Interactive Service Rows -->
      <div class="mt-8">
        {services.map((service) => (
          <div class="service-row-item group">
            <a href={`#${service.id}`} class="grid lg:grid-cols-12 gap-6 items-center">
              <div class="lg:col-span-6 flex items-baseline gap-5">
                <span class="font-mono text-xs font-bold uppercase tracking-widest text-muted">
                  /{service.num}
                </span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-ink transition-transform duration-300 group-hover:translate-x-2">
                  {service.title}
                </h3>
              </div>

              <div class="service-row-preview">
                <Picture
                  formats={['avif', 'webp']}
                  src={service.img}
                  alt={service.title}
                  class="h-full w-full object-cover"
                  widths={[400, 600]}
                  sizes="288px"
                />
              </div>

              <div class="lg:col-span-5">
                <p class="text-sm sm:text-base text-muted leading-relaxed">
                  {service.desc}
                </p>
              </div>

              <div class="lg:col-span-1 flex lg:justify-end">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line text-ink transition-all duration-300 group-hover:bg-ink group-hover:text-bg group-hover:border-ink">
                  ↓
                </span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detailed 4-Discipline Breakdown Blocks (Dark Section) -->
  <section class="section-carbon bg-grid-lines-dark py-24 md:py-36 px-6 border-b border-white/10">
    <div class="mx-auto max-w-7xl space-y-20 md:space-y-28">
      {services.map((service, index) => {
        const isReversed = index % 2 === 1;
        return (
          <div
            id={service.id}
            class="scroll-mt-28 rounded-3xl border border-white/15 bg-[#141414] overflow-hidden"
          >
            <div class="grid lg:grid-cols-12 items-center">
              <div class={`lg:col-span-6 p-8 sm:p-12 lg:p-16 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <span class="pill-subtext-dark mb-5">/{service.num}</span>
                <h3 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white mb-5">
                  {service.title}
                </h3>
                <p class="text-base text-[#A8A8A8] leading-relaxed mb-8">
                  {service.desc}
                </p>
                <ul class="space-y-3 mb-10">
                  {service.bullets.map((bullet) => (
                    <li class="flex items-start gap-3 text-sm sm:text-base text-white/90">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-white"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                <a href={localePath(lang, '/contact/')} class="learn-more-btn-dark">
                  <span>{t('nav_cta')}</span>
                  <span class="arrow-box">↗</span>
                </a>
              </div>

              <div class={`lg:col-span-6 relative aspect-[16/11] lg:aspect-[4/3] overflow-hidden bg-black media-zoom group ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <Picture
                  formats={['avif', 'webp']}
                  src={service.img}
                  alt={service.title}
                  class="h-full w-full object-cover"
                  widths={[600, 1000]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                />
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- FAQ Accordion ("Domande frequenti") -->
  <FaqAccordion
    eyebrow={t('faq_eyebrow')}
    title={t('faq_title')}
    items={faqItems}
  />

  <!-- Dual Heading CTA -->
  <DualCtaBanner lang={lang} />
</BaseLayout>

