---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import FaqAccordion from '../FaqAccordion.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';

import imgPhoto from '../../assets/blog/Giau_00001.webp';
import imgVideo from '../../assets/blog/_DSC2365.webp';
import img3d from '../../assets/blog/Giau_00004.webp';
import imgMarketing from '../../assets/blog/Landscapes_00003.webp';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    id: 'commercial-photography',
    num: '01',
    title: 'Commercial Photography',
    telemetry: 'MEDIUM & FULL-FRAME · TILT-SHIFT OPTICS · ACEScc',
    desc: t('service_1_desc'),
    img: imgPhoto,
    bullets:
      lang === 'it'
        ? [
            'Still life di prodotto e campagne e-commerce ad altissima risoluzione',
            'Fotografia d’architettura, hospitality e monografie aziendali',
            'Gestione luce da studio, negative fill e controllo riflessi speculari',
            'Post-produzione avanzata e profilo colore calibrato per web e stampa fine-art',
          ]
        : [
            'High-resolution product still life and luxury e-commerce campaigns',
            'Architectural, hospitality, and corporate editorial monographs',
            'Precision studio lighting, negative fill, and specular highlight control',
            'High-end retouching and calibrated color delivery for web & archival print',
          ],
  },
  {
    id: 'cinema-video-production',
    num: '02',
    title: 'Cinema & Video Production',
    telemetry: '2.39:1 ANAMORPHIC · PRORES 4444 XQ / RAW · 5.1 SURROUND',
    desc: t('service_2_desc'),
    img: imgVideo,
    bullets:
      lang === 'it'
        ? [
            'Spot commerciali, brand film e produzioni documentarie d’autore',
            'Regia, direzione della fotografia e movimenti camera motivati',
            'Riprese in formato Log/RAW ad alta gamma dinamica con ottiche anamorfiche',
            'Montaggio narrativo, sound design 5.1 e color grading in pipeline ACES',
          ]
        : [
            'Commercial spots, brand films, and directorial motion studies',
            'Direction, cinematography, and motivated camera movement',
            'High-dynamic-range Log/RAW cinema capture with anamorphic glass',
            'Editorial pacing, 5.1 sound architecture, and ACES color grading',
          ],
  },
  {
    id: '3d-cgi-rendering',
    num: '03',
    title: '3D CGI & Product Rendering',
    telemetry: 'GPU PATH-TRACING · SUBSTANCE PBR · 32-BIT EXR AOV',
    desc: t('service_3_desc'),
    img: img3d,
    bullets:
      lang === 'it'
        ? [
            'Rendering 3D fotorealistici di prodotto per lanci e pre-produzione',
            'Shading PBR, micro-texture e illuminazione virtuale HDRI da studio',
            'Simulazione di dispersione spettrale e animazioni 3D tecniche',
            'Compositing multipass EXR 32-bit perfettamente integrato',
          ]
        : [
            'Photorealistic 3D product renders for pre-launch and global campaigns',
            'Physically based PBR shading, micro-surface detail, and studio HDRI lighting',
            'Spectral glass dispersion simulation and 3D product motion reveals',
            '32-bit EXR multi-pass AOV compositing pipeline',
          ],
  },
  {
    id: 'digital-marketing',
    num: '04',
    title: 'Digital Marketing & Direction',
    telemetry: 'OMNICHANNEL CAMPAIGNS · TECHNICAL SEO · ART DIRECTION',
    desc: t('service_4_desc'),
    img: imgMarketing,
    bullets:
      lang === 'it'
        ? [
            'Strategia digitale integrata e direzione creativa per ecosistemi social',
            'Creazione di contenuti verticali cinema-grade e campagne ad alta conversione',
            'Ottimizzazione SEO tecnica e posizionamento editoriale del brand',
            'Pianificazione editoriale e analisi delle performance di campagna',
          ]
        : [
            'Integrated digital strategy and creative direction for brand ecosystems',
            'Cinema-grade vertical short-form assets and high-converting visual campaigns',
            'Technical SEO optimization and online brand positioning',
            'Editorial content architecture and campaign performance analytics',
          ],
  },
];

const faqItems =
  lang === 'it'
    ? [
        {
          question: 'Perché scegliere Duerre come partner unico per produzione visiva e direzione digitale?',
          answer:
            'Perché uniamo competenze verticali in fotografia commerciale, produzione cinema, 3D CGI e digital marketing sotto un’unica regia. Questo garantisce coerenza estetica, pipeline colore unificata e zero dispersioni tra fornitori.',
        },
        {
          question: 'Posso commissionare una singola disciplina o solo campagne integrate?',
          answer:
            'Entrambe le opzioni sono possibili. Puoi affidarci una singola produzione verticale (uno shooting still life, un render 3D o uno spot video) oppure un ecosistema completo che integra produzione visiva e strategia digitale.',
        },
        {
          question: 'Quali sono le tempistiche medie di una produzione?',
          answer:
            'Una sessione fotografica o render di prodotto richiede mediamente 1–2 settimane dalla pre-produzione al master finale ACES; campagne integrate o produzioni cinematografiche complesse si sviluppano su 3–6 settimane.',
        },
      ]
    : [
        {
          question: 'Why choose Duerre as a single partner for visual production and digital direction?',
          answer:
            'Because we unify vertical mastery across commercial photography, cinema production, 3D CGI rendering, and digital strategy under a single directorial vision — ensuring color consistency and narrative cohesion across every touchpoint.',
        },
        {
          question: 'Can I commission a standalone discipline or only integrated campaigns?',
          answer:
            'Both options are available. You can commission a focused production (such as a product photography shoot, 3D CGI visualization, or brand film) or partner with us for a comprehensive visual and digital launch.',
        },
        {
          question: 'What is the typical production timeline?',
          answer:
            'Focused photography or 3D CGI commissions typically span 1–2 weeks from treatment to final ACES masters; multi-deliverable cinema and omnichannel campaigns range from 3–6 weeks.',
        },
      ];
---

<Layout
  title={`${t('nav_services')} | Duerre`}
  description={t('services_desc')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('services_eyebrow')}
    title={t('nav_services')}
    subtitle={t('services_desc')}
  />

  <!-- 01. CAPABILITIES INDEX MATRIX -->
  <section class="py-24 md:py-36 px-6 sm:px-10 border-b border-line/60">
    <div class="mx-auto max-w-[1440px]">
      <div class="divide-y divide-line/60 border-y border-line/60">
        {services.map((service) => (
          <div class="service-row-item group" data-reveal>
            <a href={`#${service.id}`} class="grid lg:grid-cols-12 gap-6 items-baseline">
              <div class="lg:col-span-6 flex items-baseline gap-6">
                <span class="font-mono text-xs uppercase tracking-[0.24em] text-accent">
                  /{service.num}
                </span>
                <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light tracking-tight text-ink transition-all duration-500 group-hover:translate-x-2 group-hover:text-accent">
                  {service.title}
                </h2>
              </div>

              <div class="service-row-preview">
                <Picture
                  formats={['avif', 'webp']}
                  src={service.img}
                  alt={service.title}
                  class="h-full w-full object-cover"
                  widths={[400, 700]}
                  sizes="320px"
                />
              </div>

              <div class="lg:col-span-5">
                <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
                  {service.desc}
                </p>
              </div>

              <div class="lg:col-span-1 flex lg:justify-end">
                <span class="font-mono text-sm text-muted group-hover:text-ink transition-colors">
                  ↓
                </span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02. DETAILED 4-DISCIPLINE MONOGRAPHS -->
  <section class="section-carbon py-28 md:py-44 px-6 sm:px-10 border-b border-white/10">
    <div class="mx-auto max-w-[1440px] space-y-32 md:space-y-44">
      {services.map((service, index) => {
        const isReversed = index % 2 === 1;
        return (
          <div
            id={service.id}
            class="scroll-mt-28 grid lg:grid-cols-12 gap-12 lg:gap-20 items-center"
            data-reveal
          >
            <div class={`lg:col-span-6 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <span class="pill-subtext-dark mb-6">
                DISCIPLINE /{service.num}
              </span>
              <h3 class="display-section text-white mb-6">
                {service.title}
              </h3>
              <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-[#CCA870] mb-8">
                {service.telemetry}
              </p>
              <p class="text-base sm:text-lg font-light text-white/70 leading-relaxed mb-10">
                {service.desc}
              </p>
              <ul class="space-y-4 border-t border-white/12 pt-8 mb-12">
                {service.bullets.map((bullet) => (
                  <li class="flex items-start gap-4 text-sm sm:text-base font-light text-white/85">
                    <span class="font-mono text-xs text-[#CCA870]">—</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <a href={localePath(lang, '/contact/')} class="learn-more-btn-dark">
                <span>{t('nav_cta')}</span>
                <span class="arrow-box">↗</span>
              </a>
            </div>

            <div
              class={`lg:col-span-6 relative aspect-[4/3] overflow-hidden bg-black media-zoom group ${
                isReversed ? 'lg:order-1' : 'lg:order-2'
              }`}
            >
              <Picture
                formats={['avif', 'webp']}
                src={service.img}
                alt={service.title}
                class="h-full w-full object-cover"
                widths={[600, 1100]}
                sizes="(max-width: 1024px) 100vw, 50vw"
              />
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <FaqAccordion
    eyebrow={t('faq_eyebrow')}
    title={t('faq_title')}
    items={faqItems}
  />

  <DualCtaBanner lang={lang} />
</Layout>
