---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { getPortfolio } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getPortfolio(lang);
const categories = ['photo', 'video', '3d', 'marketing'] as const;
---

<Layout
  title={`${t('projects_title')} | Duerre`}
  description={t('projects_intro')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('projects_breadcrumb_sub')}
    title={t('projects_title')}
    subtitle={t('projects_intro')}
  />

  <section class="py-24 md:py-36 px-6 sm:px-10">
    <div class="mx-auto max-w-[1440px]">
      <!-- Editorial Discipline Filter Bar -->
      <div
        class="flex flex-wrap gap-6 pb-10 mb-16 border-b border-line/60 items-center justify-between"
        id="category-filters"
        data-reveal
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
          {t('filter_label')}
        </span>
        <div class="flex flex-wrap gap-6" role="group" aria-label={t('filter_label')}>
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="filter-pill active font-mono text-[11px] uppercase tracking-[0.24em] text-ink underline decoration-accent underline-offset-8 cursor-pointer transition-colors"
          >
            {t('all_projects_link')} [{projects.length}]
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              aria-pressed="false"
              class="filter-pill font-mono text-[11px] uppercase tracking-[0.24em] text-muted hover:text-ink cursor-pointer transition-colors"
            >
              {t(`category_${cat}`)} [{projects.filter((p) => p.data.category === cat).length}]
            </button>
          ))}
        </div>
      </div>

      <!-- Asymmetric Editorial Lookbook Archive -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10" id="projects-grid">
        {projects.map((project, idx) => {
          const spanClass =
            idx % 3 === 0
              ? 'lg:col-span-7'
              : idx % 3 === 1
                ? 'lg:col-span-5'
                : 'lg:col-span-12';
          return (
            <div
              class={`project-item ${spanClass} transition-opacity duration-500`}
              data-category={project.data.category}
            >
              <ProjectCard project={project} index={idx} lang={lang} headingTag="h2" />
            </div>
          );
        })}
      </div>

      <p
        id="projects-empty-state"
        class="hidden py-16 text-center font-mono text-xs uppercase tracking-[0.24em] text-muted"
        aria-live="polite"
      >
        {t('filter_empty')}
      </p>
    </div>
  </section>

  <DualCtaBanner lang={lang} />

  <script>
    function initPortfolioFilters() {
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
      const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
      const emptyState = document.getElementById('projects-empty-state');

      filterButtons.forEach((btn) => {
        btn.onclick = () => {
          const filter = btn.dataset.filter;

          filterButtons.forEach((b) => {
            b.classList.remove('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
            b.classList.add('text-muted');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
          btn.classList.remove('text-muted');
          btn.setAttribute('aria-pressed', 'true');

          let visibleCount = 0;
          projectItems.forEach((item) => {
            if (filter === 'all' || item.dataset.category === filter) {
              item.classList.remove('hidden');
              visibleCount++;
            } else {
              item.classList.add('hidden');
            }
          });

          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
          }
        };
      });
    }

    document.addEventListener('astro:page-load', initPortfolioFilters);
  </script>
</Layout>
