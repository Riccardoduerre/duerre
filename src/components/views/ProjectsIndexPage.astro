---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { getProjects } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout
  title={`${t('projects_title')} | Duerre`}
  description={t('projects_intro')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('projects_breadcrumb_sub')}
    title={t('projects_title')}
  />

  <section class="py-20 md:py-28 px-6 bg-grid-lines">
    <div class="mx-auto max-w-7xl">
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2.5 mb-14 items-center" id="category-filters">
        <button
          type="button"
          data-filter="all"
          class="filter-pill active px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-colors bg-ink text-bg cursor-pointer"
        >
          {t('all_projects_link')} ({projects.length})
        </button>
        <button
          type="button"
          data-filter="photo"
          class="filter-pill px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-colors bg-surface text-muted border border-line hover:border-ink hover:text-ink cursor-pointer"
        >
          {t('category_photo')} ({projects.filter((p) => p.data.category === 'photo').length})
        </button>
        <button
          type="button"
          data-filter="video"
          class="filter-pill px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-colors bg-surface text-muted border border-line hover:border-ink hover:text-ink cursor-pointer"
        >
          {t('category_video')} ({projects.filter((p) => p.data.category === 'video').length})
        </button>
        <button
          type="button"
          data-filter="3d"
          class="filter-pill px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-colors bg-surface text-muted border border-line hover:border-ink hover:text-ink cursor-pointer"
        >
          {t('category_3d')} ({projects.filter((p) => p.data.category === '3d').length})
        </button>
      </div>

      <!-- 3-Column Portfolio Grid (communicationitalia.com/portfolio style) -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10" id="projects-grid">
        {projects.map((project) => (
          <div class="project-item transition-opacity duration-300" data-category={project.data.category}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <DualCtaBanner lang={lang} />

  <script>
    function initProjectFilters() {
      const filterButtons = document.querySelectorAll('.filter-pill');
      const projectItems = document.querySelectorAll('.project-item');

      filterButtons.forEach((btn) => {
        (btn as HTMLButtonElement).onclick = () => {
          const filter = (btn as HTMLElement).dataset.filter;

          filterButtons.forEach((b) => {
            b.classList.remove('bg-ink', 'text-bg');
            b.classList.add('bg-surface', 'text-muted', 'border', 'border-line');
          });
          btn.classList.add('bg-ink', 'text-bg');
          btn.classList.remove('bg-surface', 'text-muted', 'border', 'border-line');

          projectItems.forEach((item) => {
            if (filter === 'all' || (item as HTMLElement).dataset.category === filter) {
              item.classList.remove('hidden');
            } else {
              item.classList.add('hidden');
            }
          });
        };
      });
    }

    initProjectFilters();
    document.addEventListener('astro:page-load', initProjectFilters);
  </script>
</BaseLayout>
