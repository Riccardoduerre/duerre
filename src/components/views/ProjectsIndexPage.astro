---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { splitId, type PortfolioItem } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const isVisible = (draft?: boolean) => import.meta.env.DEV || !draft;
const matchesLocale = (id: string) => {
  const parsed = splitId(id);
  return parsed.lang === lang || parsed.lang === 'shared';
};

const rawProjects = await getCollection(
  'portfolio',
  (entry: PortfolioItem) => matchesLocale(entry.id) && isVisible(entry.data.draft),
);
const projects = rawProjects.sort(
  (a: PortfolioItem, b: PortfolioItem) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title={`${t('projects_title')} | Duerre`}
  description={t('projects_intro')}
  lang={lang}
>
  <PageHero
    lang={lang}
    eyebrow={t('projects_breadcrumb_sub')}
    title={t('projects_title')}
    subtitle={t('projects_intro')}
  />

  <section class="py-24 md:py-36 px-6 sm:px-10">
    <div class="mx-auto max-w-[1440px]">
      <!-- Editorial Discipline Filter Bar -->
      <div
        class="flex flex-wrap gap-6 pb-10 mb-16 border-b border-line/60 items-center justify-between"
        id="category-filters"
        data-reveal
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
          {t('filter_label')}
        </span>
        <div class="flex flex-wrap gap-6">
          <button
            type="button"
            data-filter="all"
            class="filter-pill active font-mono text-[11px] uppercase tracking-[0.24em] text-ink underline decoration-accent underline-offset-8 cursor-pointer transition-colors"
          >
            {t('all_projects_link')} [{projects.length}]
          </button>
          <button
            type="button"
            data-filter="photo"
            class="filter-pill font-mono text-[11px] uppercase tracking-[0.24em] text-muted hover:text-ink cursor-pointer transition-colors"
          >
            {t('category_photo')} [{projects.filter((p) => p.data.category === 'photo').length}]
          </button>
          <button
            type="button"
            data-filter="video"
            class="filter-pill font-mono text-[11px] uppercase tracking-[0.24em] text-muted hover:text-ink cursor-pointer transition-colors"
          >
            {t('category_video')} [{projects.filter((p) => p.data.category === 'video').length}]
          </button>
          <button
            type="button"
            data-filter="3d"
            class="filter-pill font-mono text-[11px] uppercase tracking-[0.24em] text-muted hover:text-ink cursor-pointer transition-colors"
          >
            {t('category_3d')} [{projects.filter((p) => p.data.category === '3d').length}]
          </button>
        </div>
      </div>

      <!-- Asymmetric Editorial Lookbook Archive -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10" id="projects-grid">
        {projects.map((project, idx) => {
          const spanClass =
            idx % 3 === 0
              ? 'lg:col-span-7'
              : idx % 3 === 1
                ? 'lg:col-span-5'
                : 'lg:col-span-12';
          return (
            <div
              class={`project-item ${spanClass} transition-opacity duration-500`}
              data-category={project.data.category}
            >
              <ProjectCard project={project} index={idx} lang={lang} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <DualCtaBanner lang={lang} />

  <script>
    function initProjectFilters() {
      const filterButtons = document.querySelectorAll('.filter-pill');
      const projectItems = document.querySelectorAll('.project-item');

      filterButtons.forEach((btn) => {
        (btn as HTMLButtonElement).onclick = () => {
          const filter = (btn as HTMLElement).dataset.filter;

          filterButtons.forEach((b) => {
            b.classList.remove('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
            b.classList.add('text-muted');
          });
          btn.classList.add('text-ink', 'underline', 'decoration-accent', 'underline-offset-8');
          btn.classList.remove('text-muted');

          projectItems.forEach((item) => {
            if (filter === 'all' || (item as HTMLElement).dataset.category === filter) {
              item.classList.remove('hidden');
            } else {
              item.classList.add('hidden');
            }
          });
        };
      });
    }

    initProjectFilters();
    document.addEventListener('astro:page-load', initProjectFilters);
  </script>
</Layout>
