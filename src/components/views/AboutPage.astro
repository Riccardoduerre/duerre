---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localePath, type Locale } from '../../i18n';
import portraitImg from '../../assets/images/optimized/DSCN7050.webp';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout 
  title={`${t('nav_about')} | Duerre Media`} 
  description={t('studio_blurb')} 
  lang={lang}
  image={portraitImg.src}
>
  <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
    <!-- Main Editorial Spread -->
    <section class="grid gap-12 lg:grid-cols-12 lg:items-center mb-20">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent">
            {t('studio_eyebrow')}
          </span>
          <span class="text-line">/</span>
          <span class="font-mono text-xs text-muted">Riccardo Riva</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight mb-8">
          {t('nav_about')}
        </h1>

        <p class="text-lg md:text-xl text-muted leading-relaxed mb-6 font-medium">
          {t('studio_blurb')}
        </p>

        <p class="text-base text-muted/90 leading-relaxed mb-10">
          {lang === 'it' 
            ? 'Dall’idea iniziale alla color grading finale, curo ogni fase della produzione. Che si tratti di fotografia commerciale di prodotto, filmati promozionali o ambienti virtuali fotorealistici in 3D, l’obiettivo resta costante: eccellenza visiva senza compromessi.'
            : 'From the initial concept through to final color delivery, I manage every stage of production. Whether creating tactile product imagery, cinematic brand films, or photo-real 3D environments, the focus remains absolute: visual excellence that speaks with clarity and durability.'}
        </p>

        <div class="flex flex-wrap gap-4">
          <a href={localePath(lang, '/projects/')} class="btn-primary">
            {t('selected_works')} →
          </a>
          <a href={localePath(lang, '/contact/')} class="btn-ghost">
            {t('nav_cta')}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-2xl bg-surface border border-line shadow-2xl group">
          <Image 
            src={portraitImg} 
            alt="Riccardo Riva — Visual Director & Commercial Photographer" 
            class="w-full h-auto object-cover transition duration-700 ease-out group-hover:scale-105"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 100vw, 42vw"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white pointer-events-none">
            <span class="block font-mono text-[10px] tracking-widest text-accent uppercase mb-1">
              PORTRAIT · RICCARDO RIVA
            </span>
            <p class="text-sm font-semibold tracking-wide text-white/90">
              Visual Director & Commercial Photographer
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="prose prose-studio prose-invert max-w-none">
      <h2>Workflow & Services</h2>
      <p>
        From the first spark of an idea to the final delivery, I handle all aspects of production. 
        Whether it's a still life product shoot, an editorial fashion film, or a fully CGI rendered commercial,
        the goal is always the same: visual excellence that speaks for itself.
      </p>
      <ul>
        <li>Commercial Photography</li>
        <li>Fashion & Editorial Film</li>
        <li>3D Product Rendering</li>
        <li>Color Grading</li>
      </ul>

      <h2>Selected Clients</h2>
      <p>
        Working with forward-thinking brands, design agencies, and commercial clients across Europe who value precision, narrative depth, and visual polish.
      </p>

      <h2>Gear & Production Stack</h2>
      <div class="not-prose grid sm:grid-cols-2 gap-6 my-8">
        <div class="p-6 rounded-xl bg-surface border border-line">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-accent mb-3">Camera & Optics</h3>
          <ul class="text-sm text-muted space-y-2">
            <li>Cinema & High-Resolution Full-Frame systems</li>
            <li>Prime Cinema lenses & Tilt-Shift optical glass</li>
            <li>High-speed RAW & 10-bit Log capture</li>
          </ul>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-line">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-accent mb-3">Lighting & Grip</h3>
          <ul class="text-sm text-muted space-y-2">
            <li>Continuous Bi-Color / Daylight LED arrays</li>
            <li>High-speed strobe lighting & studio shapers</li>
            <li>Motorized sliders & camera stabilization</li>
          </ul>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-line">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-accent mb-3">Color & Finishing</h3>
          <ul class="text-sm text-muted space-y-2">
            <li>DaVinci Resolve Studio (ACES color managed)</li>
            <li>Calibrated reference monitoring</li>
            <li>Film emulation & custom show LUT development</li>
          </ul>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-line">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-accent mb-3">3D CGI & VFX</h3>
          <ul class="text-sm text-muted space-y-2">
            <li>Blender & GPU-accelerated raytracing</li>
            <li>Substance 3D PBR materials workflow</li>
            <li>Multi-pass AOV compositing pipeline</li>
          </ul>
        </div>
      </div>

      <div class="not-prose pt-12 border-t border-line text-center">
        <h2 class="text-2xl font-bold mb-4">{t('project_cta_title')}</h2>
        <p class="text-muted mb-8">{t('project_cta_desc')}</p>
        <a href={localePath(lang, '/contact/')} class="btn-primary">{t('nav_cta')}</a>
      </div>
    </div>
  </div>
</BaseLayout>
