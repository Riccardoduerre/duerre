---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PhotoGallery from '../PhotoGallery.astro';
import YouTubeEmbed from '../YouTubeEmbed.astro';
import DualCtaBanner from '../DualCtaBanner.astro';
import { splitId, type PortfolioItem } from '../../lib/content';
import { useTranslations, localePath, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  project: PortfolioItem;
  prev: PortfolioItem | null;
  next: PortfolioItem | null;
}

const { lang, project, prev, next } = Astro.props;
const { Content } = await render(project);
const t = useTranslations(lang);
---

<Layout
  title={`${project.data.title} — ${project.data.client} | Duerre`}
  description={project.data.description}
  lang={lang}
  image={project.data.coverImage.src}
  type="creativework"
>
  <article class="pt-16 md:pt-28 pb-24">
    <!-- 01. EDITORIAL CASE STUDY HEADER -->
    <header class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-14 md:mb-20" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
        <a
          href={localePath(lang, '/portfolio/')}
          class="inline-flex items-center gap-2 text-ink hover:text-accent transition-colors"
        >
          <span>←</span>
          <span>{t('nav_projects')}</span>
        </a>
        <div class="flex items-center gap-3">
          <span class="text-accent">{t(`category_${project.data.category}`)}</span>
          <span>/</span>
          <span>{project.data.year}</span>
        </div>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-end mb-16">
        <div class="lg:col-span-8">
          <h1 class="display-monument text-ink">
            {project.data.title}
          </h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-base sm:text-lg font-light text-muted leading-relaxed">
            {project.data.description}
          </p>
        </div>
      </div>

      <!-- Scannable 5-Column Production Metadata Matrix -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 py-8 border-y border-line/60">
        <div>
          <span class="block font-mono text-[9px] uppercase tracking-[0.26em] text-accent mb-2">
            01 / {t('label_client')}
          </span>
          <span class="text-sm sm:text-base font-light text-ink">{project.data.client}</span>
        </div>
        <div>
          <span class="block font-mono text-[9px] uppercase tracking-[0.26em] text-accent mb-2">
            02 / {t('label_services')}
          </span>
          <span class="text-sm sm:text-base font-light text-ink">
            {project.data.services.join(', ')}
          </span>
        </div>
        <div>
          <span class="block font-mono text-[9px] uppercase tracking-[0.26em] text-accent mb-2">
            03 / {t('label_role')}
          </span>
          <span class="text-sm sm:text-base font-light text-ink">{project.data.role}</span>
        </div>
        <div>
          <span class="block font-mono text-[9px] uppercase tracking-[0.26em] text-accent mb-2">
            04 / {t('label_year')}
          </span>
          <span class="font-mono text-sm sm:text-base text-ink">{project.data.year}</span>
        </div>
        <div class="col-span-2 md:col-span-1">
          <span class="block font-mono text-[9px] uppercase tracking-[0.26em] text-accent mb-2">
            05 / {project.data.aspectRatio ? t('label_aspect_ratio') : t('label_category')}
          </span>
          <span class="font-mono text-xs sm:text-sm text-ink">
            {project.data.aspectRatio || t(`category_${project.data.category}`)}
          </span>
        </div>
      </div>
    </header>

    <!-- 02. HIGH-IMPACT WIDESCREEN HERO FRAME -->
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-20 md:mb-32" data-reveal>
      <div class="relative w-full aspect-[16/9] md:aspect-[21/9] overflow-hidden bg-surface">
        <Picture
          formats={['avif', 'webp']}
          src={project.data.coverImage}
          alt={project.data.coverAlt}
          class="w-full h-full object-cover"
          widths={[800, 1400, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- 03. SCANNABLE CHALLENGE / EXECUTION / IMPACT TRIAD -->
    {(project.data.challenge || project.data.solution || project.data.results) && (
      <section class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-24 md:mb-32" data-reveal>
        <div class="grid md:grid-cols-3 gap-10 lg:gap-14 border-y border-line/60 py-14">
          {project.data.challenge && (
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
                {t('challenge_title')}
              </span>
              <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
                {project.data.challenge}
              </p>
            </div>
          )}

          {project.data.solution && (
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
                {t('solution_title')}
              </span>
              <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
                {project.data.solution}
              </p>
            </div>
          )}

          {project.data.results && (
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
                {t('results_title')}
              </span>
              <p class="text-sm sm:text-base font-normal text-ink leading-relaxed">
                {project.data.results}
              </p>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 04. IMMERSIVE EDITORIAL NARRATIVE & TECHNICAL SPECIFICATIONS -->
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 grid lg:grid-cols-12 gap-14 lg:gap-20 mb-28 md:mb-36">
      <!-- Left 4 Cols: Sticky Production Telemetry -->
      <aside class="lg:col-span-4 space-y-10 lg:sticky lg:top-28 self-start" data-reveal>
        {project.data.deliverables && project.data.deliverables.length > 0 && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
              {t('deliverables_title')}
            </span>
            <ul class="space-y-2.5 text-sm font-light text-muted">
              {project.data.deliverables.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="font-mono text-xs text-accent">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {project.data.gear && project.data.gear.length > 0 && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-4">
              {t('gear_title')}
            </span>
            <ul class="space-y-2 font-mono text-xs text-muted">
              {project.data.gear.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-accent/70">/</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {project.data.tags && project.data.tags.length > 0 && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted block mb-4">
              INDEX TAGS
            </span>
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span class="border border-line/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </aside>

      <!-- Right 8 Cols: Long-Form Editorial Case Study -->
      <div class="lg:col-span-8 prose prose-studio prose-lg max-w-none font-light leading-relaxed" data-reveal>
        <Content />
      </div>
    </div>

    <!-- 05. CINEMA PLAYBACK (If Video / Showreel) -->
    {project.data.youtubeId && (
      <section class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-28 md:mb-36" data-reveal>
        <div class="flex items-center justify-between border-t border-line/60 pt-8 mb-8">
          <span class="pill-subtext">CINEMA PLAYBACK · {project.data.aspectRatio || '2.39:1'}</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">MASTER STREAM</span>
        </div>
        <YouTubeEmbed
          id={project.data.youtubeId}
          title={project.data.title}
          poster={project.data.coverImage}
        />
      </section>
    )}

    <!-- 06. HIGH-RESOLUTION LOOKBOOK GALLERY -->
    {project.data.gallery && project.data.gallery.length > 0 && (
      <section class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-28 md:mb-36">
        <div class="flex items-center justify-between border-t border-line/60 pt-8 mb-12" data-reveal>
          <span class="pill-subtext">PRODUCTION PLATES & STILLS</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">
            {String(project.data.gallery.length).padStart(2, '0')} FRAMES
          </span>
        </div>
        <PhotoGallery images={project.data.gallery} />
      </section>
    )}

    <!-- 07. SEAMLESS NEXT / PREVIOUS CASE STUDY NAVIGATION -->
    {(prev || next) && (
      <nav
        aria-label="Case study pagination"
        class="mx-auto max-w-[1440px] px-6 sm:px-10 grid md:grid-cols-2 gap-10 pt-16 border-t border-line/60"
        data-reveal
      >
        <div>
          {prev && (
            <a
              href={localePath(lang, `/portfolio/${splitId(prev.id).slug}/`)}
              class="group block"
            >
              <span class="font-mono text-[10px] text-muted uppercase tracking-[0.26em] block mb-2">
                ← {t('prev_project')}
              </span>
              <span class="text-2xl sm:text-3xl font-light tracking-tight text-ink group-hover:text-accent transition-colors">
                {prev.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="md:text-right">
          {next && (
            <a
              href={localePath(lang, `/portfolio/${splitId(next.id).slug}/`)}
              class="group block"
            >
              <span class="font-mono text-[10px] text-muted uppercase tracking-[0.26em] block mb-2">
                {t('next_project')} →
              </span>
              <span class="text-2xl sm:text-3xl font-light tracking-tight text-ink group-hover:text-accent transition-colors">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>

  <DualCtaBanner lang={lang} />
</Layout>
