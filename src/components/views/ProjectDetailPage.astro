---
import { render } from 'astro:content';
import ProjectGalleryLayout from '../../layouts/ProjectGalleryLayout.astro';
import PhotoGallery from '../PhotoGallery.astro';
import YouTubeEmbed from '../YouTubeEmbed.astro';
import { splitId, type Project } from '../../lib/content';
import { useTranslations, localePath, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { lang, project, prev, next } = Astro.props;
const { Content } = await render(project);
const t = useTranslations(lang);
---

<ProjectGalleryLayout 
  title={`${project.data.title} | Duerre Media`} 
  description={project.data.description} 
  lang={lang}
  image={project.data.cover.src}
>
  <header class="mb-16 md:mb-24">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">{project.data.title}</h1>
      <p class="text-xl md:text-2xl text-muted mb-12">{project.data.description}</p>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-8 border-y border-line text-sm">
        <div>
          <span class="block text-muted mb-1 uppercase tracking-wider text-xs font-semibold">{t('label_client')}</span>
          <span class="font-medium">{project.data.client}</span>
        </div>
        <div>
          <span class="block text-muted mb-1 uppercase tracking-wider text-xs font-semibold">{t('label_role')}</span>
          <span class="font-medium">{project.data.role}</span>
        </div>
        <div>
          <span class="block text-muted mb-1 uppercase tracking-wider text-xs font-semibold">{t('label_year')}</span>
          <span class="font-medium">{project.data.year}</span>
        </div>
        <div>
          <span class="block text-muted mb-1 uppercase tracking-wider text-xs font-semibold">{t('label_category')}</span>
          <span class="font-medium">{t(`category_${project.data.category}`)}</span>
        </div>
      </div>
    </div>
  </header>

  <div class="grid lg:grid-cols-12 gap-12 lg:gap-24 mb-24">
    <div class="lg:col-span-8 prose prose-studio prose-invert max-w-none">
      <Content />
    </div>
    
    <div class="lg:col-span-4 space-y-12">
      {project.data.challenge && (
        <div>
          <h3 class="text-lg font-semibold mb-3">{t('challenge_title')}</h3>
          <p class="text-muted text-sm leading-relaxed">{project.data.challenge}</p>
        </div>
      )}
      {project.data.solution && (
        <div>
          <h3 class="text-lg font-semibold mb-3">{t('solution_title')}</h3>
          <p class="text-muted text-sm leading-relaxed">{project.data.solution}</p>
        </div>
      )}
    </div>
  </div>

  {project.data.youtubeId && (
    <div class="mb-24">
      <YouTubeEmbed id={project.data.youtubeId} title={project.data.title} />
    </div>
  )}

  {project.data.gallery && project.data.gallery.length > 0 && (
    <div class="mb-24">
      <PhotoGallery images={project.data.gallery} />
    </div>
  )}

  <!-- Previous / Next Project Navigation -->
  {(prev || next) && (
    <nav aria-label="Project pagination" class="grid grid-cols-2 gap-6 py-12 border-t border-line my-12">
      <div>
        {prev && (
          <a href={localePath(lang, `/projects/${splitId(prev.id).slug}/`)} class="group block text-left">
            <span class="text-xs text-muted uppercase tracking-wider block mb-1">← {t('prev_project')}</span>
            <span class="text-base md:text-lg font-semibold group-hover:text-accent transition-colors">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a href={localePath(lang, `/projects/${splitId(next.id).slug}/`)} class="group block text-right">
            <span class="text-xs text-muted uppercase tracking-wider block mb-1">{t('next_project')} →</span>
            <span class="text-base md:text-lg font-semibold group-hover:text-accent transition-colors">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}

  <div class="text-center py-24 border-t border-line">
    <h2 class="text-3xl font-bold mb-6">{t('project_cta_title')}</h2>
    <p class="text-muted mb-8">{t('project_cta_desc')}</p>
    <a href={localePath(lang, '/contact/')} class="btn-primary">{t('nav_cta')}</a>
  </div>
</ProjectGalleryLayout>

