---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  coverImage: ImageMetadata | string;
  coverAlt: string;
  index?: number;
  client?: string;
  year?: string | number;
  aspectRatio?: '4/5' | '16/10' | '16/9' | '1/1' | 'fill';
  aspectRatioLabel?: string;
  youtubeId?: string;
  tags?: string[];
  featured?: boolean;
  transitionSlug?: string;
  ctaLabel?: string;
  class?: string;
  revealDelay?: string;
}

const {
  title,
  description,
  href,
  category,
  coverImage,
  coverAlt,
  index = 0,
  client,
  year,
  aspectRatio = '4/5',
  aspectRatioLabel,
  youtubeId,
  tags = [],
  featured = false,
  transitionSlug,
  ctaLabel = 'Esplora il progetto',
  class: className = '',
  revealDelay,
} = Astro.props;

const indexFormatted = String(index + 1).padStart(2, '0');
const isAstroImage = typeof coverImage === 'object' && coverImage !== null && 'src' in coverImage;
const posterUrl = isAstroImage ? (coverImage as ImageMetadata).src : String(coverImage);

const aspectClasses: Record<NonNullable<Props['aspectRatio']>, { class: string; width: number; height: number }> = {
  '4/5': { class: 'aspect-[4/5]', width: 960, height: 1200 },
  '16/10': { class: 'aspect-[16/10]', width: 1280, height: 800 },
  '16/9': { class: 'aspect-[16/9]', width: 1280, height: 720 },
  '1/1': { class: 'aspect-square', width: 1000, height: 1000 },
  fill: { class: 'h-full w-full min-h-[360px]', width: 1400, height: 900 },
};

const currentAspect = aspectClasses[aspectRatio] || aspectClasses['4/5'];
const cardId = `card-title-${transitionSlug || indexFormatted}`;
const descId = `card-desc-${transitionSlug || indexFormatted}`;
---

<article
  data-reveal
  data-reveal-delay={revealDelay}
  class={`group relative flex flex-col overflow-hidden bg-surface border border-line/60 transition-colors duration-500 hover:border-accent/60 focus-within:border-accent focus-within:ring-2 focus-within:ring-accent focus-within:ring-offset-4 focus-within:ring-offset-bg ${className}`}
>
  <!-- Fixed Aspect-Ratio or Bento-Fill Media Container (Zero-CLS Guaranteed) -->
  <div
    class={`relative w-full flex-1 overflow-hidden bg-surface ${currentAspect.class} media-zoom`}
    transition:name={transitionSlug ? `project-cover-${transitionSlug}` : undefined}
  >
    {
      isAstroImage ? (
        <Picture
          formats={['avif', 'webp']}
          src={coverImage as ImageMetadata}
          alt={coverAlt}
          widths={featured ? [640, 1024, 1600] : [480, 800, 1200]}
          sizes={
            featured
              ? '(max-width: 1024px) 100vw, 66vw'
              : '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'
          }
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-center transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.045] group-focus-within:scale-[1.045]"
        />
      ) : (
        <img
          src={String(coverImage)}
          alt={coverAlt}
          width={currentAspect.width}
          height={currentAspect.height}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-center transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.045] group-focus-within:scale-[1.045]"
        />
      )
    }

    {
      youtubeId && (
        <video
          data-lazy-video
          preload="none"
          muted
          loop
          playsinline
          disablepictureinpicture
          poster={posterUrl}
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover opacity-0 group-hover:opacity-35 transition-opacity duration-700 pointer-events-none"
        />
      )
    }

    <!-- Editorial Scrim Gradient (High Contrast WCAG AA/AAA Guarantee) -->
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-[#070707]/95 via-[#070707]/35 to-[#070707]/15 opacity-80 transition-opacity duration-500 group-hover:opacity-95 group-focus-within:opacity-95"
    >
    </div>

    <!-- Top Telemetry Bar: Index + Category Badge -->
    <div
      class="absolute top-5 left-5 right-5 z-10 flex items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.24em]"
    >
      <div class="flex items-center gap-3">
        <span class="text-[#CCA870] font-medium" aria-hidden="true">
          /{indexFormatted}
        </span>
        <span
          class="inline-flex items-center rounded-sm border border-white/20 bg-[#070707]/70 px-3 py-1 text-[10px] text-[#F5F3EF] backdrop-blur-md"
        >
          {category}
        </span>
      </div>

      <div class="flex items-center gap-2">
        {
          youtubeId && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 backdrop-blur-md px-3 py-1 text-[9px] tracking-[0.24em] text-white">
              <span class="h-1.5 w-1.5 rounded-full bg-[#CCA870] animate-pulse" />
              <span>SHOWREEL · {aspectRatioLabel || '2.39:1'}</span>
            </span>
          )
        }
        {
          !youtubeId && aspectRatioLabel && (
            <span class="hidden sm:inline-block px-2.5 py-1 bg-black/45 backdrop-blur-md text-white/80 text-[9px]">
              {aspectRatioLabel}
            </span>
          )
        }
      </div>
    </div>

    <!-- Bottom Content Overlay with Hardware-Accelerated Hover/Focus Reveal -->
    <div class="absolute inset-x-5 bottom-5 z-10 flex flex-col justify-end">
      <div class="flex items-end justify-between gap-4">
        <div
          class="max-w-xl transform transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-1 group-focus-within:-translate-y-1"
        >
          {
            (client || year) && (
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[#CCA870] mb-1.5">
                {client}
                {client && year ? ' — ' : ''}
                {year}
              </p>
            )
          }

          <h3
            id={cardId}
            transition:name={transitionSlug ? `project-title-${transitionSlug}` : undefined}
            class={`${
              featured ? 'text-2xl sm:text-4xl lg:text-5xl' : 'text-xl sm:text-2xl lg:text-3xl'
            } font-light tracking-tight text-[#F5F3EF] leading-tight`}
          >
            <!-- Stretched Link Pattern for Full-Card Click & Single Tab Stop -->
            <a
              href={href}
              aria-describedby={descId}
              class="focus:outline-none after:absolute after:inset-0 after:z-20"
            >
              {title}
            </a>
          </h3>

          <!-- Zero-JS CSS Grid Height Reveal on Hover & Keyboard Focus -->
          <div
            class="grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:grid-rows-[1fr] group-hover:opacity-100 group-focus-within:grid-rows-[1fr] group-focus-within:opacity-100"
          >
            <div class="overflow-hidden">
              <p
                id={descId}
                class="pt-3 text-xs sm:text-sm font-light text-[#F5F3EF]/85 leading-relaxed line-clamp-2"
              >
                {description}
              </p>

              {
                tags.length > 0 && (
                  <ul
                    aria-label="Tecnologie e servizi utilizzati"
                    class="mt-3 flex flex-wrap gap-1.5"
                  >
                    {tags.slice(0, 3).map((tag) => (
                      <li class="border border-white/20 bg-white/[0.06] px-2.5 py-0.5 font-mono text-[9px] uppercase tracking-[0.2em] text-[#F5F3EF]/90">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </div>
        </div>

        <!-- Magnetic Action Indicator -->
        <span
          aria-hidden="true"
          title={ctaLabel}
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/30 bg-white/10 text-[#F5F3EF] backdrop-blur-md transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:border-[#CCA870] group-hover:bg-[#CCA870] group-hover:text-[#070707] group-hover:scale-105 group-focus-within:border-[#CCA870] group-focus-within:bg-[#CCA870] group-focus-within:text-[#070707]"
        >
          ↗
        </span>
      </div>
    </div>
  </div>
</article>
