---
import { type Locale, useTranslations, localePath, switchLocalePath } from '../i18n';
import { SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const otherLang = lang === 'en' ? 'it' : 'en';

const isHome = currentPath === '/' || currentPath === '/en' || currentPath === '/en/';
const isAbout = currentPath.includes('/about');
const isServices = currentPath.includes('/services');
const isProjects = currentPath.includes('/projects');
const isBlog = currentPath.includes('/blog');
const isContact = currentPath.includes('/contact');

const serviceItems = [
  { label: 'COMMERCIAL PHOTOGRAPHY', href: `${localePath(lang, '/services/')}#commercial-photography` },
  { label: 'CINEMA & VIDEO PRODUCTION', href: `${localePath(lang, '/services/')}#cinema-video-production` },
  { label: '3D CGI & PRODUCT RENDERING', href: `${localePath(lang, '/services/')}#3d-cgi-rendering` },
  { label: 'DIGITAL MARKETING', href: `${localePath(lang, '/services/')}#digital-marketing` },
];
---

<header class="sticky top-0 z-50 w-full border-b border-line/70 bg-bg/90 backdrop-blur-md transition-colors">
  <!-- Top Utility Bar (communicationitalia.com header_style4) -->
  <div class="hidden lg:block bg-[#0E0E0E] text-[#A8A8A8] border-b border-white/10 text-xs">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2">
      <div class="flex items-center gap-6">
        <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 hover:text-white transition-colors">
          <svg class="h-3.5 w-3.5 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{SITE.email}</span>
        </a>
        <span class="text-white/20">|</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          <span>{SITE.location}</span>
        </span>
      </div>

      <div class="flex items-center gap-4">
        {SITE.social.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors font-medium uppercase tracking-wider text-[11px]"
          >
            {s.name} ↗
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Sticky Navbar -->
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href={localePath(lang, '/')} class="flex items-center gap-2.5 group text-ink transition-opacity hover:opacity-80">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-ink text-bg text-xs font-extrabold tracking-tighter">
        DR
      </span>
      <span class="tracking-[-0.03em] uppercase text-base font-extrabold">Duerre</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-[13px] font-semibold tracking-wide text-muted">
      <a
        href={localePath(lang, '/')}
        class={`transition-colors hover:text-ink relative py-1 ${isHome ? 'text-ink font-bold' : ''}`}
        aria-current={isHome ? 'page' : undefined}
      >
        {t('nav_home')}
        {isHome && <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-ink rounded-full"></span>}
      </a>

      <a
        href={localePath(lang, '/about/')}
        class={`transition-colors hover:text-ink relative py-1 ${isAbout ? 'text-ink font-bold' : ''}`}
        aria-current={isAbout ? 'page' : undefined}
      >
        {t('nav_about')}
        {isAbout && <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-ink rounded-full"></span>}
      </a>

      <!-- Services with Dropdown -->
      <div class="relative group py-1">
        <a
          href={localePath(lang, '/services/')}
          class={`inline-flex items-center gap-1 transition-colors hover:text-ink relative ${isServices ? 'text-ink font-bold' : ''}`}
          aria-current={isServices ? 'page' : undefined}
        >
          <span>{t('nav_services')}</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
          {isServices && <span class="absolute -bottom-1 left-0 right-0 h-[2px] bg-ink rounded-full"></span>}
        </a>

        <!-- Dropdown Menu -->
        <div class="invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute left-0 top-full pt-3 w-72 z-50">
          <div class="rounded-2xl border border-line bg-bg p-2 shadow-2xl">
            {serviceItems.map((item) => (
              <a
                href={item.href}
                class="flex items-center justify-between rounded-xl px-4 py-3 text-[11px] font-bold uppercase tracking-[0.1em] text-muted hover:bg-surface hover:text-ink transition-colors"
              >
                <span>{item.label}</span>
                <span>↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href={localePath(lang, '/projects/')}
        class={`transition-colors hover:text-ink relative py-1 ${isProjects ? 'text-ink font-bold' : ''}`}
        aria-current={isProjects ? 'page' : undefined}
      >
        {t('nav_projects')}
        {isProjects && <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-ink rounded-full"></span>}
      </a>

      <a
        href={localePath(lang, '/blog/')}
        class={`transition-colors hover:text-ink relative py-1 ${isBlog ? 'text-ink font-bold' : ''}`}
        aria-current={isBlog ? 'page' : undefined}
      >
        {t('nav_blog')}
        {isBlog && <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-ink rounded-full"></span>}
      </a>

      <a
        href={localePath(lang, '/contact/')}
        class={`transition-colors hover:text-ink relative py-1 ${isContact ? 'text-ink font-bold' : ''}`}
        aria-current={isContact ? 'page' : undefined}
      >
        {t('nav_contact')}
        {isContact && <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-ink rounded-full"></span>}
      </a>
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden md:flex items-center gap-3">
      <div class="flex items-center rounded-full bg-surface border border-line p-0.5 text-[10px] font-bold">
        <a
          href={switchLocalePath(currentPath, 'it')}
          data-set-lang="it"
          class={`px-2.5 py-1 rounded-full transition ${lang === 'it' ? 'bg-ink text-bg' : 'text-muted hover:text-ink'}`}
          aria-label="Italiano"
        >
          IT
        </a>
        <a
          href={switchLocalePath(currentPath, 'en')}
          data-set-lang="en"
          class={`px-2.5 py-1 rounded-full transition ${lang === 'en' ? 'bg-ink text-bg' : 'text-muted hover:text-ink'}`}
          aria-label="English"
        >
          EN
        </a>
      </div>

      <ThemeToggle lang={lang} />

      <a
        href={localePath(lang, '/contact/')}
        class="hidden lg:inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.14em] text-bg transition hover:opacity-85"
      >
        <span>{t('nav_cta')}</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Mobile Navigation Toggle -->
    <div class="flex items-center gap-2.5 md:hidden">
      <a
        href={switchLocalePath(currentPath, otherLang)}
        data-set-lang={otherLang}
        class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-surface border border-line text-muted hover:text-ink"
        aria-label={t('switch_lang_label')}
      >
        {otherLang.toUpperCase()}
      </a>
      <ThemeToggle lang={lang} />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="p-2 rounded-lg text-ink hover:bg-surface focus:outline-hidden"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-bg px-6 py-6 space-y-3 text-sm font-bold uppercase tracking-[0.1em]">
    <a href={localePath(lang, '/')} class={`block py-2 hover: opacity-80 ${isHome ? 'text-ink underline underline-offset-4' : 'text-muted'}`}>{t('nav_home')}</a>
    <a href={localePath(lang, '/about/')} class={`block py-2 hover:opacity-80 ${isAbout ? 'text-ink underline underline-offset-4' : 'text-muted'}`}>{t('nav_about')}</a>
    <div class="py-2 space-y-2 border-y border-line/60">
      <a href={localePath(lang, '/services/')} class={`block ${isServices ? 'text-ink' : 'text-muted'}`}>{t('nav_services')}</a>
      <div class="pl-4 space-y-2 text-xs font-semibold text-muted">
        {serviceItems.map((item) => (
          <a href={item.href} class="block py-1 hover:text-ink">{item.label}</a>
        ))}
      </div>
    </div>
    <a href={localePath(lang, '/projects/')} class={`block py-2 hover:opacity-80 ${isProjects ? 'text-ink underline underline-offset-4' : 'text-muted'}`}>{t('nav_projects')}</a>
    <a href={localePath(lang, '/blog/')} class={`block py-2 hover:opacity-80 ${isBlog ? 'text-ink underline underline-offset-4' : 'text-muted'}`}>{t('nav_blog')}</a>
    <a href={localePath(lang, '/contact/')} class={`block py-2 hover:opacity-80 ${isContact ? 'text-ink underline underline-offset-4' : 'text-muted'}`}>{t('nav_contact')}</a>
    <div class="pt-3">
      <a href={localePath(lang, '/contact/')} class="btn-primary w-full text-center">
        {t('nav_cta')} ↗
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const barsIcon = document.getElementById('menu-icon-bars');
    const closeIcon = document.getElementById('menu-icon-close');

    if (toggleBtn && mobileMenu && barsIcon && closeIcon) {
      toggleBtn.onclick = () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
        barsIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      };
    }

    document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) => {
      link.addEventListener('click', () => {
        const targetLang = link.getAttribute('data-set-lang');
        if (targetLang) {
          try {
            localStorage.setItem('duerre_lang', targetLang);
          } catch {
            // ignore
          }
        }
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
