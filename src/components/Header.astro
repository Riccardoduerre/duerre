---
import { type Locale, useTranslations, localePath, switchLocalePath } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const otherLang = lang === 'en' ? 'it' : 'en';
---

<header class="sticky top-0 z-50 w-full border-b border-line/50 bg-bg/80 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href={localePath(lang, '/')} class="text-xl font-bold tracking-tight hover:text-accent transition-colors">Duerre Media</a>
    
    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href={localePath(lang, '/projects/')} class="hover:text-accent transition-colors">{t('nav_projects')}</a>
      <a href={localePath(lang, '/about/')} class="hover:text-accent transition-colors">{t('nav_about')}</a>
      <a href={localePath(lang, '/blog/')} class="hover:text-accent transition-colors">{t('nav_blog')}</a>
      <a href={localePath(lang, '/contact/')} class="hover:text-accent transition-colors">{t('nav_contact')}</a>
      
      <div class="flex items-center gap-4 ml-4 pl-4 border-l border-line">
        <a href={switchLocalePath(currentPath, otherLang)} class="text-xs font-bold uppercase hover:text-accent">{otherLang}</a>
      </div>
    </nav>

    <!-- Mobile Hamburger Toggle (Pure CSS) -->
    <div class="flex items-center gap-3 md:hidden">
      <a href={switchLocalePath(currentPath, otherLang)} class="text-xs font-bold uppercase hover:text-accent px-1">{otherLang}</a>
      <label 
        for="mobile-menu-toggle" 
        aria-label="Toggle navigation menu"
        class="cursor-pointer p-2 rounded-lg text-ink hover:bg-surface focus:outline-hidden"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Mobile Drawer Toggle Input & Menu (Pure CSS Peer) -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
  <div class="hidden peer-checked:block md:hidden border-t border-line bg-surface/95 backdrop-blur-sm px-6 py-6 space-y-4 text-base font-medium">
    <a href={localePath(lang, '/projects/')} class="block py-2 hover:text-accent transition-colors">{t('nav_projects')}</a>
    <a href={localePath(lang, '/about/')} class="block py-2 hover:text-accent transition-colors">{t('nav_about')}</a>
    <a href={localePath(lang, '/blog/')} class="block py-2 hover:text-accent transition-colors">{t('nav_blog')}</a>
    <a href={localePath(lang, '/contact/')} class="block py-2 hover:text-accent transition-colors">{t('nav_contact')}</a>
  </div>
</header>
