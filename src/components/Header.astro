---
import { type Locale, useTranslations, localePath, switchLocalePath } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const otherLang = lang === 'en' ? 'it' : 'en';

const isHome = currentPath === '/' || currentPath === '/en' || currentPath === '/en/';
const isProjects = currentPath.includes('/portfolio') || currentPath.includes('/projects');
const isServices = currentPath.includes('/services');
const isAbout = currentPath.includes('/about');
const isBlog = currentPath.includes('/blog');
const isContact = currentPath.includes('/contact');

const navItems = [
  { num: '01', label: t('nav_projects'), href: localePath(lang, '/portfolio/'), active: isProjects },
  { num: '02', label: t('nav_services'), href: localePath(lang, '/services/'), active: isServices },
  { num: '03', label: t('nav_about'), href: localePath(lang, '/about/'), active: isAbout },
  { num: '04', label: t('nav_blog'), href: localePath(lang, '/blog/'), active: isBlog },
  { num: '05', label: t('nav_contact'), href: localePath(lang, '/contact/'), active: isContact },
];
---

<header class="sticky top-0 z-50 w-full border-b border-line/50 bg-bg/85 backdrop-blur-xl transition-colors duration-500">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 sm:px-10 py-5">
    <!-- Brand Wordmark & Micro Coordinates -->
    <div class="flex items-center gap-6">
      <a
        href={localePath(lang, '/')}
        class="group flex items-baseline gap-3 text-ink transition-opacity duration-300 hover:opacity-75"
      >
        <span class="text-lg sm:text-xl font-bold uppercase tracking-[0.22em]">Duerre</span>
        <span class="hidden xl:inline-block font-mono text-[9px] uppercase tracking-[0.28em] text-muted">
          Visual Atelier · IT / WW
        </span>
      </a>
    </div>

    <!-- Editorial Desktop Navigation -->
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-9">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`group relative flex items-baseline gap-1.5 py-1 text-[11px] uppercase tracking-[0.22em] transition-colors duration-300 ${
            item.active ? 'text-ink font-semibold' : 'text-muted hover:text-ink'
          }`}
        >
          <span class="font-mono text-[9px] text-accent/80 transition-transform duration-300 group-hover:-translate-y-0.5">
            {item.num}
          </span>
          <span>{item.label}</span>
          <span
            class={`absolute -bottom-0.5 left-0 h-px bg-accent transition-all duration-500 ${
              item.active ? 'w-full' : 'w-0 group-hover:w-full'
            }`}
          ></span>
        </a>
      ))}
    </nav>

    <!-- Desktop Controls & Commission Link -->
    <div class="hidden md:flex items-center gap-5">
      <div class="flex items-center gap-1 font-mono text-[10px] tracking-[0.2em]">
        <a
          href={switchLocalePath(currentPath, 'it')}
          data-set-lang="it"
          class={`px-2 py-1 transition-colors ${lang === 'it' ? 'text-ink font-bold underline decoration-accent underline-offset-4' : 'text-muted hover:text-ink'}`}
          aria-label="Italiano"
        >
          IT
        </a>
        <span class="text-line">/</span>
        <a
          href={switchLocalePath(currentPath, 'en')}
          data-set-lang="en"
          class={`px-2 py-1 transition-colors ${lang === 'en' ? 'text-ink font-bold underline decoration-accent underline-offset-4' : 'text-muted hover:text-ink'}`}
          aria-label="English"
        >
          EN
        </a>
      </div>

      <ThemeToggle lang={lang} />

      <a
        href={localePath(lang, '/contact/')}
        class="inline-flex items-center gap-2.5 border border-line/80 px-5 py-2.5 font-mono text-[10px] font-medium uppercase tracking-[0.24em] text-ink transition-all duration-500 hover:border-ink hover:bg-ink hover:text-bg"
      >
        <span>{t('nav_cta')}</span>
        <span class="text-accent">↗</span>
      </a>
    </div>

    <!-- Mobile Menu Trigger -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href={switchLocalePath(currentPath, otherLang)}
        data-set-lang={otherLang}
        class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] px-2.5 py-1 border border-line/70 text-muted hover:text-ink"
        aria-label={t('switch_lang_label')}
      >
        {otherLang.toUpperCase()}
      </a>
      <ThemeToggle lang={lang} />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="p-2 text-ink hover:opacity-75 focus:outline-hidden"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8h18M3 16h18" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Editorial Mobile Overlay Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-line/50 bg-bg/98 backdrop-blur-2xl px-6 py-10 space-y-6"
  >
    <div class="space-y-4">
      <a
        href={localePath(lang, '/')}
        class={`flex items-baseline justify-between border-b border-line/40 pb-3 text-xl font-light tracking-tight ${
          isHome ? 'text-ink' : 'text-muted'
        }`}
      >
        <span>{t('nav_home')}</span>
        <span class="font-mono text-[10px] tracking-[0.24em] text-accent">00</span>
      </a>
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`flex items-baseline justify-between border-b border-line/40 pb-3 text-xl font-light tracking-tight ${
            item.active ? 'text-ink' : 'text-muted'
          }`}
        >
          <span>{item.label}</span>
          <span class="font-mono text-[10px] tracking-[0.24em] text-accent">{item.num}</span>
        </a>
      ))}
    </div>

    <div class="pt-4">
      <a href={localePath(lang, '/contact/')} class="btn-primary w-full text-center">
        <span>{t('nav_cta')}</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const barsIcon = document.getElementById('menu-icon-bars');
    const closeIcon = document.getElementById('menu-icon-close');

    if (toggleBtn && mobileMenu && barsIcon && closeIcon) {
      toggleBtn.onclick = () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
        barsIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      };
    }

    document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) => {
      link.addEventListener('click', () => {
        const targetLang = link.getAttribute('data-set-lang');
        if (targetLang) {
          try {
            localStorage.setItem('duerre_lang', targetLang);
          } catch {
            // ignore
          }
        }
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
