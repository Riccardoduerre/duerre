---
interface Props {
  id: string;
  title?: string;
}

const { id, title = 'YouTube video player' } = Astro.props;
const embedSrc = `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
---

<div class="relative w-full aspect-video rounded-xl overflow-hidden bg-surface border border-line shadow-2xl">
  <iframe 
    src={embedSrc} 
    title={title} 
    loading="lazy" 
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
    allowfullscreen 
    class="w-full h-full border-0"
  ></iframe>
</div>
