---
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { lang, eyebrow, title, subtitle } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden border-b border-line/60 pt-24 pb-20 md:pt-36 md:pb-28 px-6 sm:px-10">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid lg:grid-cols-12 gap-8 items-end" data-reveal>
      <div class="lg:col-span-9">
        <span class="pill-subtext mb-6">
          {eyebrow}
        </span>
        <h1 class="display-monument text-ink">
          {title}
        </h1>
        {subtitle && (
          <p class="mt-8 max-w-2xl text-base sm:text-xl font-light text-muted leading-relaxed">
            {subtitle}
          </p>
        )}
      </div>

      <div class="lg:col-span-3 flex lg:justify-end">
        <nav aria-label="Breadcrumb" class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted flex items-center gap-2.5">
          <a href={localePath(lang, '/')} class="hover:text-ink transition-colors">
            {t('nav_home')}
          </a>
          <span class="text-line">/</span>
          <span class="text-ink">{title}</span>
        </nav>
      </div>
    </div>
  </div>
</section>
