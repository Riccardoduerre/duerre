---
import Layout from '../../../layouts/Layout.astro';
import { translations } from '../../../i18n/index';
import Blog from '../../../views/Blog';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const t = (key: keyof typeof translations.en) => translations[lang as 'en' | 'it']?.[key] || key;
---

<Layout 
  title={t('seo_blog')} 
  description={t('seo_blog')}
>
  <Blog client:load lang={lang as 'en' | 'it'} />
</Layout>
