---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n/index';
import CategoryPage from '../../views/CategoryPage';

export function getStaticPaths() {
  const paths = [];
  for (const lang of ['en', 'it']) {
    for (const service of ['photo', 'video', '3d']) {
      paths.push({ params: { lang, service } });
    }
  }
  return paths;
}

const { lang, service } = Astro.params;
const t = (key: keyof typeof translations.en) => translations[lang as 'en' | 'it']?.[key] || key;
const seoKey = `seo_${service}` as keyof typeof translations.en;
const titleKey = service === '3d' ? 'service_3_title' : service === 'video' ? 'service_2_title' : 'service_1_title';
---

<Layout 
  title={`${t(titleKey)} | Duerre Media`} 
  description={t(seoKey)}
>
  <CategoryPage client:load lang={lang as 'en' | 'it'} id={service} />
</Layout>
