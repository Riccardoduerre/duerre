---
import { getCollection } from 'astro:content';
import { LOCALES } from '../../../i18n';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  return LOCALES.flatMap((lang) => 
    projects.map((project) => {
      return {
        params: { lang, slug: project.id.split('/')[0] },
      };
    })
  );
}

const { lang, slug } = Astro.params;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/${lang}/projects/${slug}/`} />
    <link rel="canonical" href={`/${lang}/projects/${slug}/`} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href={`/${lang}/projects/${slug}/`}>{`/${lang}/projects/${slug}/`}</a>...</p>
  </body>
</html>
