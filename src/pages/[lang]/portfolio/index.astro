---
import { LOCALES } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/${lang}/projects/`} />
    <link rel="canonical" href={`/${lang}/projects/`} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href={`/${lang}/projects/`}>{`/${lang}/projects/`}</a>...</p>
  </body>
</html>
