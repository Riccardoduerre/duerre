---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { splitId, formatDate, readingMinutes } from '../../lib/content';

type ArticleEntry = CollectionEntry<'articoli'> | CollectionEntry<'blog'>;

interface Props {
  entry: ArticleEntry;
  prev: ArticleEntry | null;
  next: ArticleEntry | null;
}

export async function getStaticPaths() {
  const isVisible = (draft?: boolean) => import.meta.env.DEV || !draft;

  const [cmsArticles, blogArticles] = await Promise.all([
    getCollection('articoli', (e) => isVisible(e.data.draft)).catch(() => []),
    getCollection('blog', (e) => {
      const parsed = splitId(e.id);
      return (parsed.lang === 'it' || parsed.lang === 'shared') && isVisible(e.data.draft);
    }).catch(() => []),
  ]);

  const bySlug = new Map<string, ArticleEntry>();
  for (const item of [...blogArticles, ...cmsArticles]) {
    const customSlug = 'slug' in item.data && item.data.slug ? item.data.slug : splitId(item.id).slug;
    bySlug.set(customSlug, item);
  }

  const sorted = Array.from(bySlug.entries())
    .sort(([, a], [, b]) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

  return sorted.map(([slug, entry], index) => {
    const prev = index > 0 ? sorted[index - 1][1] : null;
    const next = index < sorted.length - 1 ? sorted[index + 1][1] : null;
    return {
      params: { slug },
      props: { entry, prev, next },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const mins = readingMinutes(entry.body);

const isPublicUpload = typeof entry.data.coverImage === 'string';
const ogImageUrl = isPublicUpload
  ? (entry.data.coverImage as string)
  : entry.data.coverImage.src;

const getEntrySlug = (item: ArticleEntry) =>
  'slug' in item.data && item.data.slug ? item.data.slug : splitId(item.id).slug;

const categoryLabels: Record<string, string> = {
  'cinema-video': 'Cinema & Video Production',
  'fotografia': 'Fotografia Commerciale',
  '3d-cgi': '3D & CGI Rendering',
  'brand-direction': 'Digital Brand Direction',
  'dietro-le-quinte': 'Behind the Scenes & Gear',
};
const categoryLabel =
  ('category' in entry.data && entry.data.category && categoryLabels[entry.data.category]) ||
  'Editorial Journal';
---

<BaseLayout
  title={`${entry.data.title} | Duerre Editorial Journal`}
  description={entry.data.description}
  lang="it"
  image={ogImageUrl}
  imageAlt={entry.data.coverAlt || entry.data.title}
  type="article"
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-[2px] bg-accent z-50 transition-all duration-75 w-0 pointer-events-none"
    aria-hidden="true"
  ></div>

  <article class="pt-16 md:pt-28 pb-24" itemscope itemtype="https://schema.org/BlogPosting">
    <header class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-14 md:mb-20" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
        <a
          href="/articoli/"
          class="inline-flex items-center gap-2 text-ink hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <span aria-hidden="true">←</span>
          <span>Torna al Journal</span>
        </a>
        <span class="border border-line/70 px-3 py-1 text-accent">
          {categoryLabel}
        </span>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-end mb-14">
        <div class="lg:col-span-9">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-6">
            <time
              datetime={entry.data.publishDate.toISOString()}
              itemprop="datePublished"
              class="text-accent"
            >
              {formatDate(entry.data.publishDate, 'it')}
            </time>
            <span aria-hidden="true">/</span>
            <span>{mins} MIN DI LETTURA</span>
            {entry.data.tags.map((tag: string) => (
              <>
                <span aria-hidden="true">·</span>
                <span itemprop="keywords">{tag}</span>
              </>
            ))}
          </div>

          <h1 class="display-editorial text-ink" itemprop="headline">
            {entry.data.title}
          </h1>
        </div>

        <div class="lg:col-span-3">
          <p class="text-sm sm:text-base font-light text-muted leading-relaxed" itemprop="description">
            {entry.data.description}
          </p>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-20 md:mb-28" data-reveal>
      <div class="aspect-[16/9] md:aspect-[21/9] overflow-hidden bg-surface">
        {isPublicUpload ? (
          <img
            src={entry.data.coverImage as string}
            alt={entry.data.coverAlt || entry.data.title}
            class="w-full h-full object-cover"
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            itemprop="image"
          />
        ) : (
          <Picture
            formats={['avif', 'webp']}
            src={entry.data.coverImage as Exclude<typeof entry.data.coverImage, string>}
            alt={entry.data.coverAlt || entry.data.title}
            class="w-full h-full object-cover"
            widths={[800, 1400, 2000]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
    </div>

    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20">
      <aside class="lg:col-span-4 space-y-10 lg:sticky lg:top-28 self-start" data-reveal>
        <div class="border-t border-line/60 pt-6" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-3">
            AUTORE & DIREZIONE VISIVA
          </span>
          <h2 class="text-base font-medium text-ink" itemprop="name">Riccardo Riva</h2>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted mb-3" itemprop="jobTitle">
            Founder · Duerre Media
          </p>
          <p class="text-xs font-light text-muted leading-relaxed">
            Direttore visivo, fotografo commerciale e 3D artist. Specializzato in color science ACES, cinematografia e produzione visiva per brand.
          </p>
        </div>

        {entry.data.tags.length > 0 && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-muted block mb-4">
              ARGOMENTI TRATTATI
            </span>
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag: string) => (
                <span class="border border-line/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </aside>

      <div class="lg:col-span-8">
        <div
          class="prose prose-studio prose-lg max-w-none font-light leading-relaxed"
          itemprop="articleBody"
          data-reveal
        >
          <Content />
        </div>

        {(prev || next) && (
          <nav
            aria-label="Navigazione tra articoli"
            class="grid sm:grid-cols-2 gap-8 py-14 border-t border-line/60 mt-20"
            data-reveal
          >
            <div>
              {prev && (
                <a
                  href={`/articoli/${getEntrySlug(prev)}/`}
                  class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    ← Articolo Precedente
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {prev.data.title}
                  </span>
                </a>
              )}
            </div>
            <div class="sm:text-right">
              {next && (
                <a
                  href={`/articoli/${getEntrySlug(next)}/`}
                  class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    Articolo Successivo →
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {next.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
