---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { splitId, formatDate } from '../../lib/content';

type ProjectEntry = CollectionEntry<'progetti'> | CollectionEntry<'portfolio'>;

interface Props {
  entry: ProjectEntry;
  prev: ProjectEntry | null;
  next: ProjectEntry | null;
}

export async function getStaticPaths() {
  const isVisible = (draft?: boolean) => import.meta.env.DEV || !draft;

  const [cmsProjects, portfolioProjects] = await Promise.all([
    getCollection('progetti', (e) => isVisible(e.data.draft)).catch(() => []),
    getCollection('portfolio', (e) => {
      const parsed = splitId(e.id);
      return (parsed.lang === 'it' || parsed.lang === 'shared') && isVisible(e.data.draft);
    }).catch(() => []),
  ]);

  const bySlug = new Map<string, ProjectEntry>();
  for (const item of [...portfolioProjects, ...cmsProjects]) {
    const customSlug = 'slug' in item.data && item.data.slug ? item.data.slug : splitId(item.id).slug;
    bySlug.set(customSlug, item);
  }

  const sorted = Array.from(bySlug.entries())
    .sort(([, a], [, b]) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

  return sorted.map(([slug, entry], index) => {
    const prev = index > 0 ? sorted[index - 1][1] : null;
    const next = index < sorted.length - 1 ? sorted[index + 1][1] : null;
    return {
      params: { slug },
      props: { entry, prev, next },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const isPublicUpload = typeof entry.data.coverImage === 'string';
const ogImageUrl = isPublicUpload
  ? (entry.data.coverImage as string)
  : entry.data.coverImage.src;

const getEntrySlug = (item: ProjectEntry) =>
  'slug' in item.data && item.data.slug ? item.data.slug : splitId(item.id).slug;
---

<BaseLayout
  title={`${entry.data.title} — ${entry.data.client} | Duerre Portfolio`}
  description={entry.data.description}
  lang="it"
  image={ogImageUrl}
  imageAlt={entry.data.coverAlt}
  type="creativework"
  publishDate={entry.data.publishDate}
  tags={entry.data.tags}
>
  <article class="pt-16 md:pt-28 pb-24">
    <header class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-14 md:mb-20" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 font-mono text-[10px] uppercase tracking-[0.26em] text-muted">
        <a
          href="/progetti/"
          class="inline-flex items-center gap-2 text-ink hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <span aria-hidden="true">←</span>
          <span>Torna ai Progetti</span>
        </a>
        <span class="border border-line/70 px-3 py-1 text-accent">
          {entry.data.client} · {entry.data.year}
        </span>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-end mb-14">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.24em] text-muted mb-6">
            <span class="text-accent">{entry.data.role}</span>
            <span aria-hidden="true">/</span>
            <time datetime={entry.data.publishDate.toISOString()}>
              {formatDate(entry.data.publishDate, 'it', 'month')}
            </time>
          </div>
          <h1 class="display-editorial text-ink">
            {entry.data.title}
          </h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-sm sm:text-base font-light text-muted leading-relaxed">
            {entry.data.description}
          </p>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 mb-20 md:mb-28" data-reveal>
      <div class="aspect-[16/9] overflow-hidden bg-surface">
        {isPublicUpload ? (
          <img
            src={entry.data.coverImage as string}
            alt={entry.data.coverAlt}
            class="w-full h-full object-cover"
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <Picture
            formats={['avif', 'webp']}
            src={entry.data.coverImage as Exclude<typeof entry.data.coverImage, string>}
            alt={entry.data.coverAlt}
            class="w-full h-full object-cover"
            widths={[800, 1400, 2000]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
    </div>

    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20">
      <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-28 self-start" data-reveal>
        {entry.data.challenge && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-2">
              LA SFIDA
            </span>
            <p class="text-xs font-light text-muted leading-relaxed">{entry.data.challenge}</p>
          </div>
        )}
        {entry.data.solution && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-2">
              LA SOLUZIONE
            </span>
            <p class="text-xs font-light text-muted leading-relaxed">{entry.data.solution}</p>
          </div>
        )}
        {entry.data.results && (
          <div class="border-t border-line/60 pt-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent block mb-2">
              RISULTATI
            </span>
            <p class="text-xs font-light text-muted leading-relaxed">{entry.data.results}</p>
          </div>
        )}
      </aside>

      <div class="lg:col-span-8">
        <div class="prose prose-studio prose-lg max-w-none font-light leading-relaxed" data-reveal>
          <Content />
        </div>

        {(prev || next) && (
          <nav
            aria-label="Navigazione tra progetti"
            class="grid sm:grid-cols-2 gap-8 py-14 border-t border-line/60 mt-20"
            data-reveal
          >
            <div>
              {prev && (
                <a
                  href={`/progetti/${getEntrySlug(prev)}/`}
                  class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    ← Progetto Precedente
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {prev.data.title}
                  </span>
                </a>
              )}
            </div>
            <div class="sm:text-right">
              {next && (
                <a
                  href={`/progetti/${getEntrySlug(next)}/`}
                  class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="font-mono text-[10px] text-muted uppercase tracking-[0.24em] block mb-2">
                    Progetto Successivo →
                  </span>
                  <span class="text-lg sm:text-xl font-light text-ink group-hover:text-accent transition-colors">
                    {next.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
