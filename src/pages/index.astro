---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting...</title>
    <script define:vars={{ base }}>
      window.location.replace(`${base}/en/`);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={`${base}/en/`}>English site</a>...</p>
  </body>
</html>

