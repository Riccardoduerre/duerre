---
import Layout from '../layouts/Layout.astro';
import { useTranslations, DEFAULT_LOCALE } from '../i18n';

const t = useTranslations(DEFAULT_LOCALE);
---

<Layout
  title={`404 — ${t('not_found_title')} | Duerre`}
  description="Pagina non trovata"
  lang={DEFAULT_LOCALE}
>
  <section class="mx-auto max-w-[1440px] px-6 sm:px-10 py-32 md:py-48 flex flex-col items-start justify-center min-h-[70vh]">
    <span class="pill-subtext mb-6">ERROR 404 / MISSING FRAME</span>
    <h1 class="display-monument text-ink mb-8">
      {t('not_found_title')}
    </h1>
    <a href="/" class="btn-primary">
      <span>{t('thanks_back')}</span>
      <span>↗</span>
    </a>
  </section>

  <script is:inline>
    if (window.location.pathname === '/it' || window.location.pathname.startsWith('/it/')) {
      const target =
        (window.location.pathname.replace(/^\/it(?=\/|$)/, '') || '/') +
        window.location.search +
        window.location.hash;
      window.location.replace(target);
    }
  </script>
</Layout>
