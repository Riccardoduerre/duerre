---
import { getCollection } from 'astro:content';
import ProjectDetailPage from '../../../components/views/ProjectDetailPage.astro';
import { splitId, type PortfolioItem } from '../../../lib/content';

export async function getStaticPaths() {
  const isVisible = (draft?: boolean) => import.meta.env.DEV || !draft;
  const entries = await getCollection(
    'portfolio',
    (e: PortfolioItem) => {
      const parsed = splitId(e.id);
      return (parsed.lang === 'en' || parsed.lang === 'shared') && isVisible(e.data.draft);
    },
  );
  const projects = entries.sort(
    (a: PortfolioItem, b: PortfolioItem) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );

  return projects.map((project, i) => {
    const prev = i > 0 ? projects[i - 1] : null;
    const next = i < projects.length - 1 ? projects[i + 1] : null;
    return {
      params: { slug: splitId(project.id).slug },
      props: { project, prev, next },
    };
  });
}

const { project, prev, next } = Astro.props;
---

<ProjectDetailPage lang="en" project={project} prev={prev} next={next} />

