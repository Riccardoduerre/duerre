---
import ProjectDetailPage from '../../../components/views/ProjectDetailPage.astro';
import { getPortfolio, splitId, type PortfolioItem } from '../../../lib/content';

interface Props {
  project: PortfolioItem;
  prev: PortfolioItem | null;
  next: PortfolioItem | null;
}

export async function getStaticPaths() {
  const projects = await getPortfolio('en');

  return projects.map((project, i) => {
    const prev = i > 0 ? projects[i - 1] : null;
    const next = i < projects.length - 1 ? projects[i + 1] : null;
    return {
      params: { slug: splitId(project.id).slug },
      props: { project, prev, next },
    };
  });
}

const { project, prev, next } = Astro.props;
---

<ProjectDetailPage lang="en" project={project} prev={prev} next={next} />
