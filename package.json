{
  "name": "duerre",
  "private": true,
  "version": "1.0.0",
  "description": "Duerre portfolio and editorial blog — Astro static site for duerremedia.com.",
  "author": "Riccardo Riva",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "cms:dev": "npx @tinacms/cli dev -c \"astro dev\"",
    "cms:build": "npx @tinacms/cli build --skip-cloud-checks && astro build",
    "new-post": "node scripts/new-post.js",
    "new-project": "node scripts/new-project.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.2"
  }
}
